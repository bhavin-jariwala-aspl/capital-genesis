# Database
DATABASE_URL="mysql://root:password@localhost:3306/genesis_crm"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
JWT_EXPIRY="8h"

# Redis (optional — app degrades gracefully when Redis unavailable)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
# Public origin of the frontend — used in password-reset links, shared web-form and
# client upload links, and as the redirect target after a social-media OAuth callback
# (default http://localhost:5173).
APP_URL=""
# Public origin of this API as social platforms reach it for the OAuth callback
# (default: the incoming request's own origin). Set it behind a proxy. Also the base of
# the email-open tracking image (falls back to APP_URL).
API_URL=""
# Optional dedicated key for client document-upload links (default: derived from
# JWT_SECRET). Changing it invalidates links already sent.
UPLOAD_LINK_SECRET=""

# Cache TTL in seconds
CACHE_TTL_METADATA=3600
CACHE_TTL_SESSION=28800

# ── Document storage ─────────────────────────────────────────
# Blob backend for the Document Management module: "local" (default) or "s3".
STORAGE_DRIVER="local"
# Local driver: root dir (absolute, or relative to backend/). Defaults to backend/uploads.
STORAGE_ROOT=""
# Max upload size in bytes (default 25 MB).
STORAGE_MAX_FILE_SIZE=26214400
# S3 driver (used only when STORAGE_DRIVER=s3). Also works with MinIO / R2.
# Credentials may be left blank to use the default AWS credential chain (IAM role, etc.).
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="false"
STORAGE_S3_PREFIX=""
# Azure Blob Storage (STORAGE_DRIVER=azure) — connection string OR account+key
STORAGE_AZURE_CONTAINER=""
STORAGE_AZURE_CONNECTION_STRING=""
STORAGE_AZURE_ACCOUNT=""
STORAGE_AZURE_ACCOUNT_KEY=""
STORAGE_AZURE_PREFIX=""
# Google Cloud Storage (STORAGE_DRIVER=gcs) — key file OR Application Default Credentials
STORAGE_GCS_BUCKET=""
STORAGE_GCS_PROJECT_ID=""
STORAGE_GCS_KEY_FILE=""
STORAGE_GCS_PREFIX=""

# ── AI reporting ("Ask") ─────────────────────────────────────
# Natural-language report building on top of the report engine. The model only
# ever produces a report *config* (never SQL); see docs/developer-guide/AI_REPORTING.md.
AI_REPORTING_ENABLED=false
# ollama (default, local) | openai-compatible (vLLM, LM Studio, hosted) | stub (tests)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=            # openai-compatible only
LLM_TIMEOUT_MS=90000
# Reasoning traces are wasted tokens for a JSON planner — keep off unless the model needs it.
LLM_THINKING=false
