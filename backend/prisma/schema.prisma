/// Social media platform connections and configuration
model SocialMediaAccount {
  id                  Int       @id @default(autoincrement())
  platform            String    @db.VarChar(50) // linkedin | twitter | facebook | instagram | youtube | tiktok
  account_name        String    @db.VarChar(255) // @username or page name
  account_id          String    @db.VarChar(255) // platform-specific account ID
  display_name        String    @db.VarChar(255) // friendly display name
  profile_url         String?   @db.VarChar(500) // link to profile/page
  follower_count      Int?      @default(0)
  following_count     Int?      @default(0)
  post_count          Int?      @default(0)
  account_type        String    @db.VarChar(50) // personal | business | organization
  verification_status String?   @db.VarChar(50) // verified | unverified | pending
  connection_status   String    @default("active") @db.VarChar(50) // active | expired | error | disabled
  access_token        String?   @db.Text // encrypted OAuth token
  refresh_token       String?   @db.Text // encrypted refresh token
  token_expires_at    DateTime?
  last_sync_at        DateTime?
  sync_frequency      String    @default("daily") @db.VarChar(50) // hourly | daily | weekly
  auto_monitoring     Boolean   @default(true) // automatically monitor mentions/engagement
  managed_by          String?   @db.VarChar(20) // employee managing this account
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  posts     SocialMediaPost[]
  mentions  SocialMediaMention[]
  campaigns SocialMediaCampaign[]

  tenant_id Int
  tenant    Tenant @relation("TenantSocialMediaAccount", fields: [tenant_id], references: [id])

  @@unique([platform, account_id])
  @@index([platform])
  @@index([managed_by])
  @@index([connection_status])
  @@index([tenant_id])
  @@map("social_media_accounts")
}

/// Social media posts and content management
model SocialMediaPost {
  id                 Int       @id @default(autoincrement())
  account_id         Int
  platform_post_id   String    @db.VarChar(255) // platform-specific post ID
  post_type          String    @db.VarChar(50) // post | story | reel | video | carousel | live
  content            String?   @db.Text // post text content
  media_urls         Json? // images, videos, documents
  hashtags           Json? // extracted hashtags
  mentions           Json? // user mentions in post
  engagement_metrics Json? // likes, shares, comments, views
  post_url           String?   @db.VarChar(500) // direct link to post
  is_promoted        Boolean   @default(false) // paid promotion/ad
  promotion_budget   Decimal?  @db.Decimal(10, 2) // ad spend for promoted posts
  target_audience    Json? // targeting criteria for ads
  reach              Int? // total people reached
  impressions        Int? // total impressions
  click_through_rate Decimal?  @db.Decimal(5, 4) // CTR for promoted posts
  lead_generated     Boolean   @default(false) // did this post generate leads
  published_at       DateTime? // when post went live
  scheduled_for      DateTime? // scheduled posting time
  status             String    @default("draft") @db.VarChar(50) // draft | scheduled | publishing (engine claim) | published | failed | deleted
  created_by         String?   @db.VarChar(20) // employee who created post
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  account SocialMediaAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantSocialMediaPost", fields: [tenant_id], references: [id])

  @@unique([account_id, platform_post_id])
  @@index([status])
  @@index([published_at])
  @@index([lead_generated])
  @@index([tenant_id])
  @@map("social_media_posts")
}

/// Social media mentions and brand monitoring
model SocialMediaMention {
  id                 Int       @id @default(autoincrement())
  account_id         Int? // null for organic mentions not from our accounts
  platform           String    @db.VarChar(50)
  mention_type       String    @db.VarChar(50) // mention | hashtag | keyword | tag | comment | review
  content            String    @db.Text // mention text
  author_name        String    @db.VarChar(255) // who mentioned us
  author_handle      String?   @db.VarChar(255) // @username
  author_profile     String?   @db.VarChar(500) // profile URL
  follower_count     Int? // author's follower count
  post_url           String?   @db.VarChar(500) // link to the mention
  sentiment          String    @db.VarChar(20) // positive | neutral | negative
  sentiment_score    Decimal?  @db.Decimal(3, 2) // -1.0 to 1.0 sentiment score
  influence_score    Int? // 1-100 influence rating of author
  reach_estimate     Int? // estimated reach of mention
  keywords_matched   Json? // which keywords triggered this mention
  is_verified_author Boolean   @default(false) // is the author verified on platform
  requires_response  Boolean   @default(false) // needs company response
  response_priority  String    @default("medium") @db.VarChar(20) // low | medium | high | urgent
  assigned_to        String?   @db.VarChar(20) // employee assigned to handle
  response_sent      Boolean   @default(false)
  response_content   String?   @db.Text // our response
  response_sent_at   DateTime?
  mentioned_at       DateTime // when the mention occurred
  processed_at       DateTime  @default(now()) // when we detected/processed it
  created_at         DateTime  @default(now())

  account SocialMediaAccount? @relation(fields: [account_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantSocialMediaMention", fields: [tenant_id], references: [id])

  @@index([platform])
  @@index([sentiment])
  @@index([requires_response])
  @@index([assigned_to])
  @@index([mentioned_at])
  @@index([tenant_id])
  @@map("social_media_mentions")
}

/// Social media campaigns and promotions
model SocialMediaCampaign {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(255)
  description          String?  @db.Text
  campaign_type        String   @db.VarChar(50) // brand_awareness | lead_generation | promotion | engagement | traffic
  objective            String   @db.VarChar(255) // campaign goal
  target_audience      Json // demographic and interest targeting
  budget_total         Decimal? @db.Decimal(10, 2) // total campaign budget
  budget_daily         Decimal? @db.Decimal(8, 2) // daily budget limit
  currency             String   @default("USD") @db.VarChar(10)
  start_date           DateTime @db.Date
  end_date             DateTime @db.Date
  platforms            Json // platforms included in campaign
  content_themes       Json? // key messages and themes
  hashtag_strategy     Json? // primary and secondary hashtags
  posting_schedule     Json? // when to post content
  success_metrics      Json? // KPIs to track
  status               String   @default("planning") @db.VarChar(50) // planning | active | paused | completed | cancelled
  performance_summary  Json? // aggregated results
  lessons_learned      String?  @db.Text // campaign retrospective
  roi                  Decimal? @db.Decimal(8, 4) // return on investment
  lead_conversion_rate Decimal? @db.Decimal(5, 2) // % of engagements that became leads
  created_by           String   @db.VarChar(20)
  manager_id           String?  @db.VarChar(20) // campaign manager
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  accounts SocialMediaAccount[]

  tenant_id Int
  tenant    Tenant @relation("TenantSocialMediaCampaign", fields: [tenant_id], references: [id])

  @@index([status])
  @@index([start_date, end_date])
  @@index([campaign_type])
  @@index([manager_id])
  @@index([tenant_id])
  @@map("social_media_campaigns")
}

/// Social listening keywords and monitoring setup
model SocialListeningKeyword {
  id                   Int      @id @default(autoincrement())
  keyword              String   @db.VarChar(255)
  keyword_type         String   @db.VarChar(50) // brand | competitor | industry | product | hashtag
  category             String?  @db.VarChar(100) // grouping for organization
  match_type           String   @default("contains") @db.VarChar(50) // exact | contains | starts_with | ends_with
  platforms            Json // platforms to monitor
  is_case_sensitive    Boolean  @default(false)
  exclude_own_mentions Boolean  @default(true) // don't count our own posts
  alert_threshold      Int? // minimum mention volume for alerts
  priority             String   @default("medium") @db.VarChar(20) // low | medium | high
  is_active            Boolean  @default(true)
  created_by           String   @db.VarChar(20)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantSocialListeningKeyword", fields: [tenant_id], references: [id])

  @@index([keyword_type])
  @@index([is_active])
  @@index([category])
  @@index([tenant_id])
  @@map("social_listening_keywords")
}

