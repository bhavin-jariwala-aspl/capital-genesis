// ============================================================
// P6 — APPLICATION DOCUMENTS
// ============================================================
//
// Insurance application documents are now stored in the unified `Document`
// model (see above) via `application_id` / `entity_type = "application"`.
// The former `ApplicationDocument` model / `application_documents` table has
// been consolidated away — see migration `unify_document_storage`.

// ============================================================
// SLA ENGINE  (configurable service-level agreements)
// Timers attach to cases / leads / tasks. A background reconciler
// (60s tick, see SlaService) computes business-hours-aware due
// dates, flags at-risk / breached instances, and runs escalations.
// ============================================================

/// A working-hours calendar. SLA clocks only tick inside these windows.
/// Timezone is stored as a fixed UTC offset (minutes) to stay DST-free and
/// dependency-free; `timezone_label` is for display only.
model SlaBusinessHours {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(100)
  timezone_label     String   @default("UTC") @db.VarChar(50)
  utc_offset_minutes Int      @default(0) // e.g. 330 = IST (+05:30)
  /// { "mon": [["09:00","17:00"]], "tue": [...], ... }  omitted/empty day = non-working
  weekly             Json
  /// ["2026-12-25", "2026-01-01"] — full non-working days (local calendar)
  holidays           Json?
  is_default         Boolean  @default(false)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  policies SlaPolicy[]

  tenant_id Int
  tenant    Tenant @relation("TenantSlaBusinessHours", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("sla_business_hours")
}

/// A configurable SLA policy. First matching active policy (by order_index)
/// for a record wins. `conditions` is an AND-list evaluated against the record.
model SlaPolicy {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  description       String?  @db.Text
  entity_type       String   @db.VarChar(20) // case | lead | task
  is_active         Boolean  @default(true)
  order_index       Int      @default(0)
  /// [{ "field": "priority", "op": "equals", "value": "high" }, ...]  (AND)
  conditions        Json?
  /// Record statuses that PAUSE the clock (e.g. ["on_hold"] for cases)
  pause_statuses    Json?
  business_hours_id Int?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  business_hours SlaBusinessHours? @relation(fields: [business_hours_id], references: [id], onDelete: SetNull)
  targets        SlaTarget[]
  escalations    SlaEscalation[]
  instances      SlaInstance[]

  tenant_id Int
  tenant    Tenant @relation("TenantSlaPolicy", fields: [tenant_id], references: [id])

  @@index([tenant_id, entity_type, is_active, order_index])
  @@map("sla_policies")
}

/// Target minutes for a metric at a given priority dimension.
/// `priority` = "*" means "any / default". For cases the dimension is
/// priority, for leads it is rating, for tasks it is priority.
model SlaTarget {
  id             Int    @id @default(autoincrement())
  policy_id      Int
  metric         String @db.VarChar(30) // first_response | resolution
  priority       String @default("*") @db.VarChar(20)
  target_minutes Int
  warning_pct    Int    @default(80) // % of target elapsed → "at risk"

  policy SlaPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantSlaTarget", fields: [tenant_id], references: [id])

  @@unique([policy_id, metric, priority])
  @@index([policy_id])
  @@index([tenant_id])
  @@map("sla_targets")
}

/// An automated action fired when a metric hits a warning or breach.
model SlaEscalation {
  id          Int    @id @default(autoincrement())
  policy_id   Int
  metric      String @db.VarChar(30) // first_response | resolution | * (any)
  trigger     String @db.VarChar(20) // warning | breach
  action      String @db.VarChar(40) // notify_owner | notify_manager | raise_priority | create_task
  /// action-specific config, e.g. { "role": "manager" } or { "levels": 1 }
  config      Json?
  order_index Int    @default(0)

  policy SlaPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantSlaEscalation", fields: [tenant_id], references: [id])

  @@index([policy_id])
  @@index([tenant_id])
  @@map("sla_escalations")
}

/// A live SLA timer for one (record, metric). Created/updated by the reconciler.
model SlaInstance {
  id             Int       @id @default(autoincrement())
  policy_id      Int
  entity_type    String    @db.VarChar(20) // case | lead | task
  entity_id      Int
  metric         String    @db.VarChar(30) // first_response | resolution
  priority       String    @db.VarChar(20) // dimension value at creation
  owner_id       String?   @db.VarChar(20) // record owner/assignee at last sync
  target_minutes Int
  started_at     DateTime // record creation (clock start)
  due_at         DateTime // business-hours-aware deadline
  warning_at     DateTime // at-risk threshold
  paused_at      DateTime? // set while clock is paused
  status         String    @default("running") @db.VarChar(20) // running | paused | met | breached | canceled
  warned         Boolean   @default(false)
  breached       Boolean   @default(false)
  completed_at   DateTime? // when met
  breached_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  policy SlaPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantSlaInstance", fields: [tenant_id], references: [id])

  @@unique([entity_type, entity_id, metric])
  @@index([tenant_id, status])
  @@index([status, due_at])
  @@index([owner_id])
  @@index([policy_id])
  @@map("sla_instances")
}
