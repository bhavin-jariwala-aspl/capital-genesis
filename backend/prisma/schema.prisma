  application InsuranceApplication? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  carrier     InsuranceCarrier?     @relation(fields: [carrier_id], references: [id], onDelete: SetNull)
  statement   CommissionStatement?  @relation(fields: [statement_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantCommissionEntry", fields: [tenant_id], references: [id])

  @@index([agent_id])
  @@index([policy_id])
  @@index([application_id])
  @@index([status])
  @@index([commission_period])
  @@index([statement_id])
  @@index([tenant_id])
