}

/// Key-value configuration per tenant
model TenantConfig {
  id           Int      @id @default(autoincrement())
  tenant_id    Int
  config_key   String   @db.VarChar(100)
  config_value String?  @db.Text
  updated_by   String?  @db.VarChar(20)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, config_key])
  @@map("tenant_configs")
}

/// Usage metrics per tenant per period
model TenantUsage {
  id          Int      @id @default(autoincrement())
  tenant_id   Int
  metric      String   @db.VarChar(50) // api_calls | storage_mb | active_users | records | emails_sent
  value       Decimal  @db.Decimal(18, 2)
  period      String   @db.VarChar(20) // 2026-04 | 2026-Q1 | 2026
  period_type String   @db.VarChar(20) // daily | monthly | quarterly | annual
  recorded_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, metric, period, period_type])
  @@index([tenant_id])
  @@index([metric])
  @@index([period])
  @@map("tenant_usage")
}

/// Subscription plans available in the platform
model SubscriptionPlan {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(50) // free | starter | professional | enterprise
  label          String   @db.VarChar(100)
  description    String?  @db.Text
  price_monthly  Decimal  @default(0) @db.Decimal(10, 2)
  price_annual   Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("USD") @db.VarChar(10)
  max_users      Int      @default(5)
  max_storage_mb Int      @default(500)
  max_api_calls  Int      @default(10000)
  max_records    Int      @default(10000)
  max_workflows  Int      @default(5)
  max_dashboards Int      @default(3)
  features       Json? // ["email_templates", "workflow_automation", "api_access"]
  limits         Json? // additional granular limits
  is_active      Boolean  @default(true)
  trial_days     Int      @default(14)
  order_index    Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([is_active])
  @@map("subscription_plans")
}

/// Global feature flags for progressive rollouts
model FeatureFlag {
  id              Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(100) // e.g. "ai_lead_scoring", "advanced_workflows"
  label           String   @db.VarChar(200)
  description     String?  @db.Text
  category        String   @default("general") @db.VarChar(50) // general | beta | experimental | premium
  is_enabled      Boolean  @default(false) // global default
  rollout_percent Int      @default(0) // 0-100 gradual rollout
  config          Json? // flag-specific settings
  created_by      String?  @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant_overrides TenantFeatureOverride[]

  @@index([category])
  @@index([is_enabled])
  @@map("feature_flags")
}

/// Per-tenant override of a feature flag
model TenantFeatureOverride {
  id         Int      @id @default(autoincrement())
  tenant_id  Int
  flag_id    Int
  is_enabled Boolean
  config     Json? // tenant-specific flag config
  updated_by String?  @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  flag   FeatureFlag @relation(fields: [flag_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, flag_id])
  @@map("tenant_feature_overrides")
}

/// Platform-level audit log — tracks all platform admin actions
model PlatformAuditLog {
  id          Int      @id @default(autoincrement())
  admin_id    String   @db.VarChar(20) // platform admin employee_id
  action      String   @db.VarChar(100) // tenant.create | tenant.suspend | user.impersonate | flag.toggle | plan.update | ...
  target_type String?  @db.VarChar(50) // tenant | user | feature_flag | plan | announcement | security
  target_id   String?  @db.VarChar(100) // ID of affected entity
  details     Json? // action-specific payload
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now())

  @@index([admin_id])
  @@index([action])
  @@index([target_type, target_id])
  @@index([created_at])
  @@map("platform_audit_logs")
}

/// System-wide announcements pushed to all tenants / users
model SystemAnnouncement {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  message        String    @db.Text
  severity       String    @default("info") @db.VarChar(20) // info | warning | critical | maintenance
  type           String    @default("banner") @db.VarChar(50) // banner | modal | toast | page
  target         String    @default("all") @db.VarChar(50) // all | admins | specific_tenants
  target_ids     Json? // tenant IDs if target=specific_tenants
  action_url     String?   @db.VarChar(500)
  action_label   String?   @db.VarChar(100)
  is_active      Boolean   @default(true)
  is_dismissible Boolean   @default(true)
  active_from    DateTime  @default(now())
  active_to      DateTime?
  created_by     String?   @db.VarChar(20)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([is_active])
  @@index([active_from, active_to])
  @@index([severity])
  @@map("system_announcements")
}

/// Impersonation session log — every "login as" action is tracked
model ImpersonationLog {
  id               Int       @id @default(autoincrement())
  admin_id         String    @db.VarChar(20) // platform admin who initiated
  target_user_id   String    @db.VarChar(20) // user being impersonated
  target_tenant_id Int?
  reason           String?   @db.Text
  started_at       DateTime  @default(now())
  ended_at         DateTime?
  actions_taken    Json? // summary of actions during session
  ip_address       String?   @db.VarChar(45)

  @@index([admin_id])
  @@index([target_user_id])
  @@index([started_at])
  @@map("impersonation_logs")
}

/// API rate limit configuration per tenant/plan
model ApiRateLimit {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(100)
  plan_name           String?  @db.VarChar(50) // NULL = global default
  tenant_id           Int? // NULL = plan-level default
  endpoint_pattern    String?  @db.VarChar(255) // e.g. "/api/runtime/*" or NULL for all
  requests_per_minute Int      @default(60)
  requests_per_hour   Int      @default(1000)
  requests_per_day    Int      @default(10000)
  burst_limit         Int      @default(100)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([plan_name])
  @@index([tenant_id])
  @@map("api_rate_limits")
}

/// Security policy enforcement per tenant
model SecurityPolicy {
  id                       Int      @id @default(autoincrement())
  tenant_id                Int? // NULL = global default
  require_mfa              Boolean  @default(false)
  password_min_length      Int      @default(8)
  password_require_upper   Boolean  @default(true)
  password_require_number  Boolean  @default(true)
  password_require_special Boolean  @default(false)
  password_expiry_days     Int      @default(0) // 0 = never expires
  max_login_attempts       Int      @default(5)
  lockout_duration_min     Int      @default(30)
  session_timeout_min      Int      @default(480) // 8 hours
  ip_allowlist             Json? // ["192.168.1.0/24"]
  ip_blocklist             Json?
  allowed_domains          Json? // email domain restrictions
  force_password_reset     Boolean  @default(false)
  is_active                Boolean  @default(true)
  updated_by               String?  @db.VarChar(20)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@index([tenant_id])
  @@map("security_policies")
}

/// Data export / backup request tracking
model DataExportRequest {
  id           Int       @id @default(autoincrement())
  tenant_id    Int?
  requested_by String    @db.VarChar(20)
  export_type  String    @db.VarChar(50) // full_backup | partial | gdpr_export | gdpr_delete
  scope        Json? // { tables: [...], date_range: {...} }
  status       String    @default("pending") @db.VarChar(50) // pending | processing | completed | failed | expired
  file_path    String?   @db.VarChar(500)
  file_size    BigInt?
  error        String?   @db.Text
  expires_at   DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([tenant_id])
  @@index([status])
  @@index([requested_by])
  @@map("data_export_requests")
}

/// Admin-sent push notification log — history of manual notifications
model PushNotificationLog {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(200)
  body            String?  @db.Text
  link            String?  @db.VarChar(500)
  target_type     String   @db.VarChar(20) // all | role | employee
  target_value    Json? // role names or employee IDs
  recipient_count Int      @default(0)
  sent_by         String   @db.VarChar(20) // admin employee_id
  created_at      DateTime @default(now())

  tenant_id Int
  tenant    Tenant @relation("TenantPushNotificationLog", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([sent_by])
  @@map("push_notification_logs")
}

// ============================================================
// INSURANCE DOMAIN TABLES
// First-class insurance CRM / AMS domain models.
// Each entity that hosts activities/tasks/documents gets a 
// record_id bridge → records.id  (same pattern as CRM entities).
// ============================================================

/// Insurance carrier / insurer company
model InsuranceCarrier {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  code           String   @db.VarChar(50) // short identifier e.g. "PRUD"
  naic_code      String?  @db.VarChar(10) // NAIC company code
  am_best_rating String?  @db.VarChar(10) // A++, A+, A, A-, B++, …
  carrier_type   String   @default("life") @db.VarChar(50) // life | health | p_and_c | multi_line
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(100)
  website        String?  @db.VarChar(255)
  is_active      Boolean  @default(true)
  created_by     String?  @db.VarChar(20)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  carrier_products      CarrierProduct[]
  policies              InsurancePolicy[]
  applications          InsuranceApplication[]
  commissions           CommissionEntry[]
  producer_appointments ProducerAppointment[]
  commission_statements CommissionStatement[]
  adapter_config        CarrierAdapterConfig?

  tenant_id Int
  tenant    Tenant @relation("TenantInsuranceCarrier", fields: [tenant_id], references: [id])

  @@unique([code, tenant_id])
  @@index([is_active])
  @@index([tenant_id])
  @@map("insurance_carriers")
}

/// Per-carrier adapter integration configuration.
/// Controls how the rating engine sources quotes for this carrier:
///   - simulated  : internal engine with carrier-specific rate adjustments (default)
///   - api        : real carrier REST API integration (requires apiBaseUrl + env key)
///   - disabled   : carrier excluded from interactive rating
///
/// Secrets (API keys) are NEVER stored here. Only the env-var name is stored, and
/// the runtime reads process.env[api_key_env_var] at boot time.
model CarrierAdapterConfig {
  id                   Int       @id @default(autoincrement())
  carrier_id           Int       @unique
  adapter_type         String    @default("simulated") @db.VarChar(30) // simulated | api | disabled
  api_base_url         String?   @db.VarChar(500) // HTTPS endpoint for real carrier API
  api_key_env_var      String?   @db.VarChar(100) // env var NAME e.g. "CARRIER_GLA_API_KEY"
  timeout_ms           Int       @default(10000)
  is_enabled           Boolean   @default(true)
  environment          String    @default("sandbox") @db.VarChar(20) // sandbox | production
  supported_products   Json? // array of product_type strings this adapter handles
  notes                String?   @db.Text // free-text admin notes
  last_health_check_at DateTime?
  health_status        String?   @db.VarChar(20) // ok | error | unconfigured | degraded | unknown
  health_detail        String?   @db.Text // last error message or success detail
  updated_at           DateTime  @updatedAt
  created_at           DateTime  @default(now())

  carrier InsuranceCarrier @relation(fields: [carrier_id], references: [id], onDelete: Cascade)

  @@map("carrier_adapter_configs")
}

/// Carrier-specific product (maps to a carrier's filing / plan code)
model CarrierProduct {
  id           Int      @id @default(autoincrement())
  carrier_id   Int
  product_type String   @db.VarChar(50) // term_life | whole_life | universal_life | variable_life | iul | final_expense
  name         String   @db.VarChar(255)
  plan_code    String?  @db.VarChar(100) // carrier's internal plan code
  description  String?  @db.Text
  min_coverage Decimal? @db.Decimal(18, 2)
  max_coverage Decimal? @db.Decimal(18, 2)
  min_age      Int?
  max_age      Int?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  carrier      InsuranceCarrier       @relation(fields: [carrier_id], references: [id], onDelete: Cascade)
  policies     InsurancePolicy[]
  applications InsuranceApplication[]

  tenant_id Int
  tenant    Tenant @relation("TenantCarrierProduct", fields: [tenant_id], references: [id])

  @@index([carrier_id])
  @@index([product_type])
  @@index([tenant_id])
  @@map("carrier_products")
}

/// First-class insurance policy (issued, in-force or terminal)
model InsurancePolicy {
  id                 Int       @id @default(autoincrement())
  record_id          Int?      @unique // bridge → records.id (activities/tasks/docs)
  policy_number      String    @db.VarChar(100)
  carrier_id         Int?
  carrier_product_id Int?
  contact_id         Int? // policyholder → crm_contacts
  account_id         Int? // corporate owner → crm_accounts
  agent_id           String?   @db.VarChar(20) // producer → employees
  application_id     Int?      @unique
  product_type       String    @db.VarChar(50) // term_life | whole_life | universal_life | variable_life | iul | final_expense
  product_name       String?   @db.VarChar(255)
  coverage_amount    Decimal   @db.Decimal(18, 2)
  premium_amount     Decimal   @db.Decimal(18, 2)
  premium_frequency  String    @default("monthly") @db.VarChar(20) // monthly | quarterly | semi_annual | annual
  status             String    @default("active") @db.VarChar(30) // pending | active | lapsed | surrendered | matured | cancelled
  effective_date     DateTime  @db.Date
  expiry_date        DateTime? @db.Date
  renewal_due_date   DateTime? @db.Date
  is_lapsed          Boolean   @default(false)
  lapsed_at          DateTime?
  reinstated_at      DateTime?
  surrender_value    Decimal?  @db.Decimal(18, 2)
  death_benefit      Decimal?  @db.Decimal(18, 2)
  last_payment_date  DateTime? @db.Date
  notes              String?   @db.Text
  created_by         String?   @db.VarChar(20)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  record               Record?                        @relation(fields: [record_id], references: [id], onDelete: SetNull)
  carrier              InsuranceCarrier?              @relation(fields: [carrier_id], references: [id], onDelete: SetNull)
  carrier_product      CarrierProduct?                @relation(fields: [carrier_product_id], references: [id], onDelete: SetNull)
  contact              CrmContact?                    @relation("PolicyContact", fields: [contact_id], references: [id], onDelete: SetNull)
  account              CrmAccount?                    @relation("PolicyAccount", fields: [account_id], references: [id], onDelete: SetNull)
  agent                Employee?                      @relation("PolicyAgent", fields: [agent_id], references: [employee_id], onDelete: SetNull)
  application          InsuranceApplication?          @relation(fields: [application_id], references: [id], onDelete: SetNull)
  beneficiaries        InsurancePolicyBeneficiary[]
  status_history       InsurancePolicyStatusHistory[]
  claims               InsuranceClaim[]
  commissions          CommissionEntry[]
  endorsements         PolicyEndorsement[]
  renewal_tasks        RenewalTask[]
  billing_schedule     BillingSchedule?
  invoices             PolicyInvoice[]
  compliance_artifacts ComplianceArtifact[]           @relation("PolicyCompliance")

  tenant_id Int
  tenant    Tenant @relation("TenantInsurancePolicy", fields: [tenant_id], references: [id])

  @@unique([policy_number, tenant_id])
  @@index([contact_id])
  @@index([agent_id])
  @@index([status])
  @@index([carrier_id])
  @@index([renewal_due_date])
  @@index([tenant_id])
  @@map("insurance_policies")
}

/// Beneficiaries on a policy
model InsurancePolicyBeneficiary {
  id               Int       @id @default(autoincrement())
  policy_id        Int
  name             String    @db.VarChar(255)
  relationship     String?   @db.VarChar(100) // spouse | child | parent | sibling | trust | other
  beneficiary_type String    @default("primary") @db.VarChar(20) // primary | contingent
  allocation_pct   Decimal   @default(100) @db.Decimal(5, 2) // 0-100
  contact_id       Int? // link to existing CrmContact
  date_of_birth    DateTime? @db.Date
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  policy  InsurancePolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  contact CrmContact?     @relation("BeneficiaryContact", fields: [contact_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantInsurancePolicyBeneficiary", fields: [tenant_id], references: [id])

  @@index([policy_id])
  @@index([tenant_id])
  @@map("insurance_policy_beneficiaries")
}

/// Auditable status history for a policy
model InsurancePolicyStatusHistory {
  id          Int      @id @default(autoincrement())
  policy_id   Int
  from_status String?  @db.VarChar(30)
  to_status   String   @db.VarChar(30)
  reason      String?  @db.Text
  changed_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())

  policy InsurancePolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantInsurancePolicyStatusHistory", fields: [tenant_id], references: [id])

  @@index([policy_id])
  @@index([tenant_id])
  @@map("insurance_policy_status_history")
}

/// Insurance application — pre-policy intake and underwriting queue
model InsuranceApplication {
  id                 Int       @id @default(autoincrement())
  record_id          Int?      @unique // bridge → records.id
  app_number         String    @db.VarChar(100)
  contact_id         Int? // applicant → crm_contacts
  account_id         Int?
  agent_id           String?   @db.VarChar(20) // producer → employees
  carrier_id         Int?
  carrier_product_id Int?
  product_type       String    @db.VarChar(50)
  product_name       String?   @db.VarChar(255)
  coverage_amount    Decimal   @db.Decimal(18, 2)
  premium_amount     Decimal?  @db.Decimal(18, 2)
  status             String    @default("submitted") @db.VarChar(30) // submitted | under_review | pending_medical | approved | declined | withdrawn | issued
  submitted_at       DateTime  @default(now())
  age                Int?
  gender             String?   @db.VarChar(20) // male | female | non_binary
  date_of_birth      DateTime? @db.Date
  is_smoker          Boolean   @default(false)
  health_class       String?   @db.VarChar(30) // preferred_plus | preferred | standard_plus | standard | substandard
  term_years         Int?
  payment_frequency  String?   @db.VarChar(20) // monthly | quarterly | semi_annual | annual
  height_in          Int?
  weight_lbs         Int?
  notes              String?   @db.Text
  created_by         String?   @db.VarChar(20)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  record                Record?               @relation(fields: [record_id], references: [id], onDelete: SetNull)
  contact               CrmContact?           @relation("ApplicationContact", fields: [contact_id], references: [id], onDelete: SetNull)
  account               CrmAccount?           @relation("ApplicationAccount", fields: [account_id], references: [id], onDelete: SetNull)
  agent                 Employee?             @relation("ApplicationAgent", fields: [agent_id], references: [employee_id], onDelete: SetNull)
  carrier               InsuranceCarrier?     @relation(fields: [carrier_id], references: [id], onDelete: SetNull)
  carrier_product       CarrierProduct?       @relation(fields: [carrier_product_id], references: [id], onDelete: SetNull)
  underwriting_case     UnderwritingCase?
  policy                InsurancePolicy?
  commissions           CommissionEntry[]
  quote_scenarios       QuoteScenario[]
  compliance_artifacts  ComplianceArtifact[]  @relation("AppCompliance")
  submission_checklist  SubmissionChecklist[]
  application_documents Document[]            @relation("AppDocuments")

  tenant_id Int
  tenant    Tenant @relation("TenantInsuranceApplication", fields: [tenant_id], references: [id])

  @@unique([app_number, tenant_id])
  @@index([contact_id])
  @@index([agent_id])
  @@index([status])
  @@index([carrier_id])
  @@index([tenant_id])
  @@map("insurance_applications")
}

/// Underwriting case — created from an application, drives the UW decision
model UnderwritingCase {
  id                   Int       @id @default(autoincrement())
  case_number          String    @db.VarChar(100)
  application_id       Int       @unique // one case per application
  assigned_underwriter String?   @db.VarChar(20) // employee_id
  status               String    @default("pending") @db.VarChar(30) // pending | in_progress | approved | declined | referred
  risk_class           String?   @db.VarChar(30) // preferred_plus | preferred | standard | substandard | high_risk | decline
  bmi                  Float?
  blood_pressure       String?   @db.VarChar(30)
  cholesterol          Int?
  medical_conditions   String?   @db.Text
  medications          String?   @db.Text
  family_history       String?   @db.Text
  decision_notes       String?   @db.Text
  decided_at           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  application          InsuranceApplication      @relation(fields: [application_id], references: [id], onDelete: Cascade)
  underwriter_employee Employee?                 @relation("UWCaseUnderwriter", fields: [assigned_underwriter], references: [employee_id], onDelete: SetNull)
  requirements         UnderwritingRequirement[]

  tenant_id Int
  tenant    Tenant @relation("TenantUnderwritingCase", fields: [tenant_id], references: [id])

  @@unique([case_number, tenant_id])
  @@index([status])
  @@index([assigned_underwriter])
  @@index([tenant_id])
  @@map("underwriting_cases")
}

/// Checklist item / requirement on an underwriting case
model UnderwritingRequirement {
  id               Int       @id @default(autoincrement())
  case_id          Int
  description      String    @db.VarChar(500)
  requirement_type String    @db.VarChar(50) // medical_exam | lab_work | records | attending_physician | inspection | other
  status           String    @default("pending") @db.VarChar(30) // pending | received | waived | not_required
  due_date         DateTime? @db.Date
  received_at      DateTime?
  notes            String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  uw_case UnderwritingCase @relation(fields: [case_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantUnderwritingRequirement", fields: [tenant_id], references: [id])

  @@index([case_id])
  @@index([tenant_id])
  @@map("underwriting_requirements")
}

/// Insurance claim filed against a policy
model InsuranceClaim {
  id                    Int       @id @default(autoincrement())
  record_id             Int?      @unique // bridge → records.id
  claim_number          String    @db.VarChar(100)
  policy_id             Int
  contact_id            Int? // claimant → crm_contacts
  claim_type            String    @db.VarChar(50) // death | disability | critical_illness | accident | other
  amount                Decimal   @db.Decimal(18, 2)
  status                String    @default("filed") @db.VarChar(30) // fnol | filed | under_investigation | approved | denied | paid | closed
  priority              String    @default("medium") @db.VarChar(20) // high | medium | low
  adjuster_id           String?   @db.VarChar(20) // employee_id
  filed_at              DateTime  @default(now())
  description           String?   @db.Text
  paid_at               DateTime?
  paid_amount           Decimal?  @db.Decimal(18, 2)
  denial_reason         String?   @db.Text
  // FNOL (First Notice of Loss) fields
  reporter_name         String?   @db.VarChar(255)
  reporter_phone        String?   @db.VarChar(50)
  reporter_relationship String?   @db.VarChar(100) // insured | beneficiary | third_party | agent
  loss_date             DateTime? @db.Date
  loss_location         String?   @db.VarChar(500)
  loss_description      String?   @db.Text
  fnol_received_at      DateTime?
  // Reserve & fraud/litigation
  reserve_amount        Decimal?  @db.Decimal(18, 2)
  is_fraud_flagged      Boolean   @default(false)
  is_litigation         Boolean   @default(false)
  litigation_details    String?   @db.Text
  created_by            String?   @db.VarChar(20)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  record         Record?             @relation(fields: [record_id], references: [id], onDelete: SetNull)
  policy         InsurancePolicy     @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  contact        CrmContact?         @relation("ClaimContact", fields: [contact_id], references: [id], onDelete: SetNull)
  adjuster       Employee?           @relation("ClaimAdjuster", fields: [adjuster_id], references: [employee_id], onDelete: SetNull)
  events         ClaimEvent[]
  reserves       ClaimReserve[]
  payment_events ClaimPaymentEvent[]

  tenant_id Int
  tenant    Tenant @relation("TenantInsuranceClaim", fields: [tenant_id], references: [id])

  @@unique([claim_number, tenant_id])
  @@index([policy_id])
  @@index([status])
  @@index([claim_type])
  @@index([adjuster_id])
  @@index([tenant_id])
  @@map("insurance_claims")
}

/// Timeline event on a claim
model ClaimEvent {
  id          Int      @id @default(autoincrement())
  claim_id    Int
  event_type  String   @db.VarChar(50) // filed | note | document_received | decision | payment | other
  description String   @db.VarChar(500)
  created_by  String?  @db.VarChar(20)
