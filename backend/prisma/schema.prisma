/// Custom report definitions for advanced analytics
model CustomReport {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  description       String?   @db.Text
  report_type       String    @db.VarChar(50) // table | chart | dashboard | pivot | summary
  category          String    @db.VarChar(100) // sales | marketing | support | performance | finance
  data_source       Json // { objects: ["lead", "opportunity"], joins: [...] }
  fields            Json // [{ field: "amount", alias: "Revenue", aggregation: "sum" }]
  filters           Json? // [{ field: "stage", operator: "in", values: ["closed_won"] }]
  grouping          Json? // [{ field: "owner_id", period: "month" }]
  sorting           Json? // [{ field: "amount", direction: "desc" }]
  chart_config      Json? // chart type, colors, axes configuration
  /// Denormalised "has at least one active subscription", kept in sync by
  /// ReportScheduleService so the report list can show a schedule badge without
  /// joining. The schedule itself lives in ReportSubscription.
  is_scheduled      Boolean   @default(false)
  schedule_config   Json? // legacy single-schedule blob; superseded by ReportSubscription
  is_shared         Boolean   @default(false)
  shared_with       Json? // employee IDs, role names or team ids — see `visibility`
  /// private = author only · team = the author's reporting line · shared = the
  /// roles/employees listed in shared_with · everyone = all users in the tenant
  visibility        String    @default("private") @db.VarChar(20)
  folder_id         Int?
  refresh_frequency String?   @db.VarChar(50) // legacy, unused
  last_run_at       DateTime?
  /// Trend history: { version, columns, snapshots:[{at,scope,row_count,grand}] },
  /// one entry per scope per day, bounded — see report-snapshots.js. (Name is
  /// historical; it no longer caches a result.)
  cached_result     Json?
  cache_expires_at  DateTime? // legacy, unused
  created_by        String    @db.VarChar(20)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  executions    ReportExecution[]
  subscriptions ReportSubscription[]
  favorites     ReportFavorite[]
  folder        ReportFolder?        @relation(fields: [folder_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantCustomReport", fields: [tenant_id], references: [id])

  @@index([report_type, category])
  @@index([created_by])
  @@index([is_shared])
  @@index([folder_id])
  @@index([tenant_id])
  @@map("custom_reports")
}

/// Report execution history for performance monitoring
model ReportExecution {
  id             Int      @id @default(autoincrement())
  report_id      Int
  executed_by    String?  @db.VarChar(20) // NULL for scheduled runs
  execution_time Int // milliseconds
  status         String   @db.VarChar(50) // success | error | timeout | cancelled
  result_rows    Int? // number of rows returned
  error_message  String?  @db.Text
  filters_used   Json? // runtime filters applied
  cache_hit      Boolean  @default(false)
  executed_at    DateTime @default(now())

  report CustomReport @relation(fields: [report_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantReportExecution", fields: [tenant_id], references: [id])

  @@index([report_id])
  @@index([executed_at])
  @@index([status])
  @@index([tenant_id])
  @@map("report_executions")
}

/// Folder a report can be filed in, so a growing report library stays navigable.
/// Mirrors the report-folder concept in Salesforce, Zoho and Dynamics.
model ReportFolder {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  color       String?  @db.VarChar(20)
  parent_id   Int?
  order_index Int      @default(0)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent   ReportFolder?  @relation("ReportFolderTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children ReportFolder[] @relation("ReportFolderTree")
  reports  CustomReport[]

  tenant_id Int
  tenant    Tenant @relation("TenantReportFolder", fields: [tenant_id], references: [id])

  @@index([parent_id])
  @@index([tenant_id])
  @@map("report_folders")
}

/// A recurring emailed delivery of a saved report ("subscription" in Salesforce,
/// "scheduled report" in HubSpot/Zoho). Owned by the employee who created it, so
/// a business user can schedule their own reports with no admin involvement.
/// `next_run_at` is what the sweeper claims on, and is recomputed after each send.
model ReportSubscription {
  id           Int       @id @default(autoincrement())
  report_id    Int
  employee_id  String    @db.VarChar(20) // subscription owner; always a recipient
  frequency    String    @db.VarChar(20) // daily | weekdays | weekly | monthly
  hour         Int       @default(8) // local hour of day, 0–23
  day_of_week  Int? // 0 (Sun) – 6, for weekly
  day_of_month Int? // 1–28, for monthly
  format       String    @default("xlsx") @db.VarChar(10) // xlsx | csv | inline
  recipients   Json? // additional email addresses
  scope        String    @default("all") @db.VarChar(10) // me | team | all (clamped to the owner's role)
  subject      String?   @db.VarChar(255)
  message      String?   @db.Text
  is_active    Boolean   @default(true)
  last_sent_at DateTime?
  last_status  String?   @db.VarChar(20) // sent | error | skipped
  last_error   String?   @db.Text
  next_run_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  report CustomReport @relation(fields: [report_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantReportSubscription", fields: [tenant_id], references: [id])

  @@index([report_id])
  @@index([employee_id])
  @@index([is_active, next_run_at])
  @@index([tenant_id])
  @@map("report_subscriptions")
}

/// Per-user starred report, so each person gets their own shortlist.
model ReportFavorite {
  id          Int      @id @default(autoincrement())
  report_id   Int
  employee_id String   @db.VarChar(20)
  created_at  DateTime @default(now())

  report CustomReport @relation(fields: [report_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantReportFavorite", fields: [tenant_id], references: [id])

  @@unique([report_id, employee_id])
  @@index([employee_id])
  @@index([tenant_id])
  @@map("report_favorites")
}

