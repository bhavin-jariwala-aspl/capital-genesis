  integrations                    Integration[]                  @relation("TenantIntegration")
  integration_logs                IntegrationLog[]               @relation("TenantIntegrationLog")
  crm_accounts                    CrmAccount[]                   @relation("TenantCrmAccount")
  crm_contacts                    CrmContact[]                   @relation("TenantCrmContact")
  crm_leads                       CrmLead[]                      @relation("TenantCrmLead")
  crm_lead_intakes                CrmLeadIntake[]                @relation("TenantCrmLeadIntake")
  crm_opportunitys                CrmOpportunity[]               @relation("TenantCrmOpportunity")
  crm_cases                       CrmCase[]                      @relation("TenantCrmCase")
  crm_lead_conversions            CrmLeadConversion[]            @relation("TenantCrmLeadConversion")
  crm_associations                CrmAssociation[]               @relation("TenantCrmAssociation")
  products                        Product[]                      @relation("TenantProduct")
  quotes                          Quote[]                        @relation("TenantQuote")
  quote_line_items                QuoteLineItem[]                @relation("TenantQuoteLineItem")
  email_templates                 EmailTemplate[]                @relation("TenantEmailTemplate")
  email_logs                      EmailLog[]                     @relation("TenantEmailLog")
  documents                       Document[]                     @relation("TenantDocument")
  document_folders                DocumentFolder[]               @relation("TenantDocumentFolder")
  document_share_links            DocumentShareLink[]            @relation("TenantDocumentShareLink")
  document_view_events            DocumentViewEvent[]            @relation("TenantDocumentViewEvent")
  document_templates              DocumentTemplate[]             @relation("TenantDocumentTemplate")
  document_signature_requests     DocumentSignatureRequest[]     @relation("TenantDocumentSignatureRequest")
  document_signatories            DocumentSignatory[]            @relation("TenantDocumentSignatory")
  ui_document_categories          UiDocumentCategory[]           @relation("TenantUiDocumentCategory")
  ui_document_checklists          UiDocumentChecklist[]          @relation("TenantUiDocumentChecklist")
  lead_scoring_rules              LeadScoringRule[]              @relation("TenantLeadScoringRule")
  lead_scores                     LeadScore[]                    @relation("TenantLeadScore")
  record_field_values             RecordFieldValue[]             @relation("TenantRecordFieldValue")
  custom_reports                  CustomReport[]                 @relation("TenantCustomReport")
  report_executions               ReportExecution[]              @relation("TenantReportExecution")
  report_folders                  ReportFolder[]                 @relation("TenantReportFolder")
  report_subscriptions            ReportSubscription[]           @relation("TenantReportSubscription")
  report_favorites                ReportFavorite[]               @relation("TenantReportFavorite")
  social_media_accounts           SocialMediaAccount[]           @relation("TenantSocialMediaAccount")
  social_media_posts              SocialMediaPost[]              @relation("TenantSocialMediaPost")
  social_media_mentions           SocialMediaMention[]           @relation("TenantSocialMediaMention")
  social_media_campaigns          SocialMediaCampaign[]          @relation("TenantSocialMediaCampaign")
  social_listening_keywords       SocialListeningKeyword[]       @relation("TenantSocialListeningKeyword")
  social_assignment_rules         SocialAssignmentRule[]         @relation("TenantSocialAssignmentRule")
  push_notification_logs          PushNotificationLog[]          @relation("TenantPushNotificationLog")
  // Insurance domain
  insurance_carriers              InsuranceCarrier[]             @relation("TenantInsuranceCarrier")
  carrier_products                CarrierProduct[]               @relation("TenantCarrierProduct")
  insurance_policies              InsurancePolicy[]              @relation("TenantInsurancePolicy")
  insurance_policy_beneficiaries  InsurancePolicyBeneficiary[]   @relation("TenantInsurancePolicyBeneficiary")
  insurance_policy_status_history InsurancePolicyStatusHistory[] @relation("TenantInsurancePolicyStatusHistory")
  insurance_applications          InsuranceApplication[]         @relation("TenantInsuranceApplication")
  underwriting_cases              UnderwritingCase[]             @relation("TenantUnderwritingCase")
  underwriting_requirements       UnderwritingRequirement[]      @relation("TenantUnderwritingRequirement")
  insurance_claims                InsuranceClaim[]               @relation("TenantInsuranceClaim")
  claim_events                    ClaimEvent[]                   @relation("TenantClaimEvent")
  commission_entries              CommissionEntry[]              @relation("TenantCommissionEntry")
  // P0: Rating
  quote_scenarios                 QuoteScenario[]                @relation("TenantQuoteScenario")
  // P1: Compliance
  compliance_artifacts            ComplianceArtifact[]           @relation("TenantComplianceArtifact")
  submission_checklists           SubmissionChecklist[]          @relation("TenantSubmissionChecklist")
  // P2: Policy servicing & billing
  policy_endorsements             PolicyEndorsement[]            @relation("TenantPolicyEndorsement")
  renewal_tasks                   RenewalTask[]                  @relation("TenantRenewalTask")
  billing_schedules               BillingSchedule[]              @relation("TenantBillingSchedule")
  policy_invoices                 PolicyInvoice[]                @relation("TenantPolicyInvoice")
  policy_payments                 PolicyPayment[]                @relation("TenantPolicyPayment")
  // P3: Claims ops
  claim_reserves                  ClaimReserve[]                 @relation("TenantClaimReserve")
  claim_payment_events            ClaimPaymentEvent[]            @relation("TenantClaimPaymentEvent")
  // P4: Producer ops
  producer_appointments           ProducerAppointment[]          @relation("TenantProducerAppointment")
  commission_statements           CommissionStatement[]          @relation("TenantCommissionStatement")
  sla_business_hours              SlaBusinessHours[]             @relation("TenantSlaBusinessHours")
  sla_policies                    SlaPolicy[]                    @relation("TenantSlaPolicy")
  sla_targets                     SlaTarget[]                    @relation("TenantSlaTarget")
  sla_escalations                 SlaEscalation[]                @relation("TenantSlaEscalation")
