/// Commission entry: one per producer event (policy issued / application approved)
model CommissionEntry {
  id                Int       @id @default(autoincrement())
  agent_id          String    @db.VarChar(20) // employee_id (producer)
  policy_id         Int?
  application_id    Int?
  carrier_id        Int?
  product_type      String    @db.VarChar(50)
  commission_type   String    @default("first_year") @db.VarChar(30) // first_year | renewal | override | bonus
  source_premium    Decimal   @db.Decimal(18, 2) // premium this commission is based on
  commission_rate   Decimal   @db.Decimal(5, 2) // e.g. 55.00 for 55%
  commission_amount Decimal   @db.Decimal(18, 2)
  expected_amount   Decimal?  @db.Decimal(18, 2) // expected from rate schedule
  variance          Decimal?  @db.Decimal(18, 2) // actual - expected
  commission_period String    @db.VarChar(7) // "2026-03"
  status            String    @default("pending") @db.VarChar(20) // pending | paid | clawed_back
