// Genesis CRM — Prisma Schema
// MySQL via AWS RDS
//
// Naming convention:
//   ui_*  → UI configuration tables  (modules, objects, fields, forms, dashboards, etc.)
//   *     → Operational/org tables   (employees, roles, regions, branches, hierarchy, records)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // fullTextIndex graduated to GA in Prisma 6 — no longer a preview feature.
}

// ============================================================
// ORGANIZATIONAL / AUTH TABLES
// ============================================================

model Region {
  region_id   Int      @id @default(autoincrement())
  region_name String   @db.VarChar(100)
  region_code String   @unique @db.VarChar(10)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  branches  Branch[]
  employees Employee[]

  tenant_id Int
  tenant    Tenant @relation("TenantRegion", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("regions")
}

model Branch {
  branch_id   Int      @id @default(autoincrement())
  branch_name String   @db.VarChar(100)
  branch_code String   @unique @db.VarChar(10)
  region_id   Int
  address     String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  region    Region     @relation(fields: [region_id], references: [region_id])
  employees Employee[]

  tenant_id Int
  tenant    Tenant @relation("TenantBranch", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("branches")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50) // e.g. super_admin | admin | manager | user | custom names
  label       String   @db.VarChar(100)
  description String?  @db.Text
  level       Int      @default(1) // hierarchy level determines access scope
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  tenant_id   Int? // NULL = system default role; set = tenant custom role

  tenant Tenant? @relation("TenantRole", fields: [tenant_id], references: [id])

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("roles")
}

model Employee {
  employee_id         String    @id @db.VarChar(20)
  employee_name       String    @db.VarChar(100)
  role                String    @db.VarChar(50) // role name (validated in app code)
  email               String?   @unique @db.VarChar(100)
  phone               String?   @db.VarChar(20)
  password            String    @db.VarChar(255)
  branch_id           Int?
  region_id           Int?
  is_active           Boolean   @default(true)
  reset_token         String?   @db.VarChar(255) // sha256 hash of the active password-reset token
  reset_token_expires DateTime? // when the reset token stops being valid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  branch Branch? @relation(fields: [branch_id], references: [branch_id])
  region Region? @relation(fields: [region_id], references: [region_id])
  // role_ref removed — Role is now tenant-scoped with @@unique([tenant_id, name])
  // Role lookup done in application code via (tenant_id, role) pair

  // Closure table relations
  as_ancestor   EmployeeHierarchy[] @relation("HierarchyAncestor")
  as_descendant EmployeeHierarchy[] @relation("HierarchyDescendant")

  activities              Activity[]
  tasks_assigned          Task[]           @relation("TaskAssignee")
  tasks_created           Task[]           @relation("TaskCreator")
  reminders_assigned      Reminder[]       @relation("ReminderAssignee")
  reminders_created       Reminder[]       @relation("ReminderCreator")
  notifications           Notification[]
  audit_logs              AuditLog[]
  assigned_records        Record[]         @relation("RecordAssignee")
  quotas                  Quota[]
  crm_leads_owned         CrmLead[]        @relation("LeadOwner")
  crm_lead_intakes_owned  CrmLeadIntake[]  @relation("LeadIntakeOwner")
  crm_contacts_owned      CrmContact[]     @relation("ContactOwner")
  crm_accounts_owned      CrmAccount[]     @relation("AccountOwner")
  crm_opportunities_owned CrmOpportunity[] @relation("OpportunityOwner")
  crm_cases_owned         CrmCase[]        @relation("CaseOwner")
  quotes_owned            Quote[]

  // Calendar/meeting relations  

  // Territory and team management relations

  // Insurance relations
  insurance_policies     InsurancePolicy[]      @relation("PolicyAgent")
  insurance_applications InsuranceApplication[] @relation("ApplicationAgent")
  uw_cases               UnderwritingCase[]     @relation("UWCaseUnderwriter")
  claim_adjustments      InsuranceClaim[]       @relation("ClaimAdjuster")
  commissions            CommissionEntry[]      @relation("CommissionAgent")
  commission_splits      CommissionEntry[]      @relation("CommissionSplitAgent")
  endorsements_approved  PolicyEndorsement[]    @relation("EndorsementApprover")
  renewal_tasks          RenewalTask[]          @relation("RenewalAgent")
  producer_appointments  ProducerAppointment[]  @relation("AgentAppointment")

  tenant_id Int
  tenant    Tenant @relation("TenantEmployee", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("employees")
}

/// Closure table that stores ALL ancestor–descendant pairs at every depth.
/// Self-referencing row (depth=0) is always inserted for every employee.
model EmployeeHierarchy {
  ancestor_id   String @db.VarChar(20)
  descendant_id String @db.VarChar(20)
  depth         Int    @default(0)

  ancestor   Employee @relation("HierarchyAncestor", fields: [ancestor_id], references: [employee_id], onDelete: Cascade)
  descendant Employee @relation("HierarchyDescendant", fields: [descendant_id], references: [employee_id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantEmployeeHierarchy", fields: [tenant_id], references: [id])

  @@id([ancestor_id, descendant_id])
  @@index([descendant_id])
  @@index([depth])
  @@index([tenant_id])
  @@map("employee_hierarchy")
}

// ============================================================
// UI CONFIGURATION TABLES  (all prefixed with "ui_")
// These are cached in Redis for fast metadata access.
// ============================================================

/// Top-level navigation / functional grouping
model UiModule {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50) // Lucide icon name
  color       String?  @db.VarChar(20) // Tailwind color e.g. "blue"
  category    String   @default("crm") @db.VarChar(50) // Sidebar grouping: crm, insurance, tools
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  objects UiObject[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiModule", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_modules")
}

/// Data entity within a module (e.g. Lead, Contact, Account inside Sales)
model UiObject {
  id           Int      @id @default(autoincrement())
  module_id    Int
  name         String   @db.VarChar(100)
  label        String   @db.VarChar(100)
  plural_label String?  @db.VarChar(100)
  description  String?  @db.Text
  icon         String?  @db.VarChar(50)
  order_index  Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  module           UiModule         @relation(fields: [module_id], references: [id])
  fields           UiField[]
  forms            UiForm[]
  pages            UiPage[]
  pipelines        UiPipeline[]
  workflows        UiWorkflow[]
  wizards          UiWizard[]
  records          Record[]
  assignment_rules AssignmentRule[]
  import_jobs      ImportJob[]
  quotas           Quota[]
  email_templates  EmailTemplate[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiObject", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_objects")
}

/// Field definition for an object.
/// field_type maps to the UI component family.
/// Supported field_type values:
///   text | textarea | number | email | phone | url |
///   date | datetime | time |
///   select | multi_select | radio | checkbox |
///   currency | percentage | rating |
///   color | file | image | rich_text | code |
///   lookup | formula | auto_number
model UiField {
  id            Int      @id @default(autoincrement())
  object_id     Int
  name          String   @db.VarChar(100) // API/DB column name (snake_case)
  label         String   @db.VarChar(100)
  field_type    String   @db.VarChar(50)
  data_type     String   @db.VarChar(50) // string | number | boolean | date | array | object
  is_required   Boolean  @default(false)
  is_unique     Boolean  @default(false)
  is_searchable Boolean  @default(true)
  is_sortable   Boolean  @default(true)
  is_indexed    Boolean  @default(false) // Creates a generated column + index on records table for this field
  default_value String?  @db.Text
  placeholder   String?  @db.VarChar(200)
  help_text     String?  @db.Text
  options       Json? // For select/radio/checkbox: [{value, label, color?}]
  config        Json? // Field-type-specific config
  order_index   Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  object                 UiObject            @relation(fields: [object_id], references: [id])
  validations            UiValidation[]
  dependencies_as_source UiFieldDependency[] @relation("DepSourceField")
  dependencies_as_target UiFieldDependency[] @relation("DepTargetField")
  form_field_layouts     UiFormFieldLayout[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiField", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_fields")
}

/// Form definition for an object (create | edit | view | search)
model UiForm {
  id          Int      @id @default(autoincrement())
  object_id   Int
  name        String   @db.VarChar(100)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  form_type   String   @db.VarChar(50) // create | edit | view | search | modal
  columns     Int      @default(2) // Default grid columns (1–4)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  object        UiObject            @relation(fields: [object_id], references: [id])
  field_layouts UiFormFieldLayout[]
  wizard_steps  UiWizardStep[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiForm", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_forms")
}

/// Placement of a field within a form (row/col grid layout)
model UiFormFieldLayout {
  id          Int     @id @default(autoincrement())
  form_id     Int
  field_id    Int
  row         Int     @default(0)
  col         Int     @default(0)
  col_span    Int     @default(1) // How many columns this field occupies
  order_index Int     @default(0)
  is_visible  Boolean @default(true)
  config      Json? // Override label, placeholder etc.

  form  UiForm  @relation(fields: [form_id], references: [id], onDelete: Cascade)
  field UiField @relation(fields: [field_id], references: [id])

  tenant_id Int
  tenant    Tenant @relation("TenantUiFormFieldLayout", fields: [tenant_id], references: [id])

  @@unique([form_id, field_id])
  @@index([tenant_id])
  @@map("ui_form_field_layouts")
}

/// Validation rule attached to a field.
/// validation_type: required | min | max | minLength | maxLength | pattern | custom
model UiValidation {
  id              Int     @id @default(autoincrement())
  field_id        Int
  validation_type String  @db.VarChar(50)
  value           String? @db.VarChar(500) // e.g. "10" for min, "^[A-Z].*" for pattern
  error_message   String  @db.VarChar(500)
  order_index     Int     @default(0)

  field UiField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantUiValidation", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_validations")
}

/// Inter-field dependency rule.
/// "When source_field [condition_type] condition_value → apply action_type to target_field"
/// condition_type: equals | not_equals | contains | not_contains | gt | lt | gte | lte | in | not_in | is_empty | is_not_empty
/// action_type:    show | hide | enable | disable | require | unrequire | set_value | set_options | clear
model UiFieldDependency {
  id              Int     @id @default(autoincrement())
  source_field_id Int
  target_field_id Int
  condition_type  String  @db.VarChar(50)
  condition_value String? @db.Text
  action_type     String  @db.VarChar(50)
  action_value    String? @db.Text // For set_value / set_options actions

  source_field UiField @relation("DepSourceField", fields: [source_field_id], references: [id], onDelete: Cascade)
  target_field UiField @relation("DepTargetField", fields: [target_field_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantUiFieldDependency", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_field_dependencies")
}

/// Custom JavaScript function that auto-populates a target field.
/// trigger_event: on_change | on_blur | on_load
/// function_type: calculate | fetch_api | transform
/// Page definition (list page, detail page, custom page)
model UiPage {
  id         Int      @id @default(autoincrement())
  object_id  Int?
  name       String   @db.VarChar(100)
  label      String   @db.VarChar(100)
  page_type  String   @db.VarChar(50) // list | detail | dashboard | custom
  config     Json?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  object UiObject? @relation(fields: [object_id], references: [id])

  tenant_id Int
  tenant    Tenant @relation("TenantUiPage", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_pages")
}

/// Dashboard definition
model UiDashboard {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  min_role    String?  @db.VarChar(50) // NULL = all roles; 'manager' = manager + admin + super_admin only
  is_default  Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  widgets UiDashboardWidget[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiDashboard", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_dashboards")
}

/// Widget placed on a dashboard grid.
/// x, y, w, h in react-grid-layout units.
/// widget_type: chart | table | list | metric | pipeline | custom_html
model UiDashboardWidget {
  id           Int     @id @default(autoincrement())
  dashboard_id Int
  widget_type  String  @db.VarChar(50)
  title        String? @db.VarChar(200)
  x            Int     @default(0)
  y            Int     @default(0)
  w            Int     @default(6) // Width in grid units (default 12-col grid)
  h            Int     @default(4) // Height in grid units
  chart_id     Int?
  config       Json? // Widget-type-specific config
  // { type: "endpoint", dataset }  → GET /api/analytics/data/<dataset> (default)
  // { type: "api", url, method?, headers?, dataPath? } → external REST endpoint
  // { type: "json", data } → static inline payload (back-compat)
  data_source  Json?
  order_index  Int     @default(0)
  is_active    Boolean @default(true)

  dashboard UiDashboard @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  chart     UiChart?    @relation(fields: [chart_id], references: [id])

  tenant_id Int
  tenant    Tenant @relation("TenantUiDashboardWidget", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_dashboard_widgets")
}

/// Chart / Graph definition.
/// chart_type: bar | bar_stacked | line | area | area_stacked | pie | donut |
///             scatter | bubble | radar | radial_bar | treemap | funnel |
///             heatmap | candlestick | gauge | waterfall | composed | timeline
model UiChart {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  label       String   @db.VarChar(100)
  chart_type  String   @db.VarChar(50)
  config      Json? // Chart-library-specific config
  data_source Json? // Same data_source shape as widgets
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  widgets UiDashboardWidget[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiChart", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_charts")
}

/// Workflow automation definition
/// trigger_type: on_create | on_update | on_delete | scheduled | manual
model UiWorkflow {
  id             Int       @id @default(autoincrement())
  object_id      Int?
  name           String    @db.VarChar(100)
  label          String    @db.VarChar(100)
  description    String?   @db.Text
  trigger_type   String    @db.VarChar(50)
  trigger_config Json? // e.g. { fields: ["status"], interval_minutes: 60 }
  is_active      Boolean   @default(true)
  last_run_at    DateTime? // stamped by the scheduler / engine on each execution
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  object       UiObject?             @relation(fields: [object_id], references: [id])
  steps        UiWorkflowStep[]
  pendingSteps WorkflowPendingStep[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiWorkflow", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_workflows")
}

/// Individual step within a workflow.
/// step_type: trigger | condition | action | notification | delay | approval | webhook | create_record | update_related
model UiWorkflowStep {
  id          Int    @id @default(autoincrement())
  workflow_id Int
  name        String @db.VarChar(100)
  step_type   String @db.VarChar(50)
  order_index Int    @default(0)
  config      Json? // Step-type-specific configuration
  on_true_id  Int? // Next step when condition is true
  on_false_id Int? // Next step when condition is false (conditions only)

  workflow UiWorkflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantUiWorkflowStep", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_workflow_steps")
}

/// Paused workflow execution — written by "delay" and "approval" step handlers.
/// For delays:   resume_after is set; scheduler polls and continues from resume_step_id.
/// For approvals: approval_token is set; continued by POST /api/runtime/workflows/approval/:token.
model WorkflowPendingStep {
  id              Int       @id @default(autoincrement())
  workflow_id     Int
  resume_step_id  Int?
  record_id       Int?
  actor_id        String?   @db.VarChar(100)
  context         Json? // { record, reject_step_id } — serialized execution snapshot
  resume_after    DateTime?
  approval_token  String?   @unique @db.VarChar(255)
  approval_status String?   @default("pending") @db.VarChar(20) // pending|resumed|approved|rejected
  created_at      DateTime  @default(now())

  workflow UiWorkflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantWorkflowPendingStep", fields: [tenant_id], references: [id])

  @@index([resume_after])
  @@index([tenant_id])
  @@map("workflow_pending_steps")
}

/// Multi-step wizard (guided information capture flow)
model UiWizard {
  id              Int      @id @default(autoincrement())
  object_id       Int?
  name            String   @db.VarChar(100)
  label           String   @db.VarChar(100)
  description     String?  @db.Text
  submit_label    String?  @db.VarChar(100)
  success_message String?  @db.VarChar(255)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  object UiObject?      @relation(fields: [object_id], references: [id])
  steps  UiWizardStep[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiWizard", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_wizards")
}

/// One step within a wizard — each step maps to a form
model UiWizardStep {
  id          Int     @id @default(autoincrement())
  wizard_id   Int
  form_id     Int?
  name        String  @db.VarChar(100)
  label       String  @db.VarChar(100)
  description String? @db.Text
  order_index Int     @default(0)
  config      Json?

  wizard UiWizard @relation(fields: [wizard_id], references: [id], onDelete: Cascade)
  form   UiForm?  @relation(fields: [form_id], references: [id])

  tenant_id Int
  tenant    Tenant @relation("TenantUiWizardStep", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_wizard_steps")
}

/// Kanban/pipeline board for an object
model UiPipeline {
  id          Int      @id @default(autoincrement())
  object_id   Int
  name        String   @db.VarChar(100)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  config      Json? // { enabled_views: ['table','cards','pipeline'] }
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  object UiObject          @relation(fields: [object_id], references: [id])
  stages UiPipelineStage[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiPipeline", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_pipelines")
}

/// Stage within a pipeline
model UiPipelineStage {
  id          Int    @id @default(autoincrement())
  pipeline_id Int
  name        String @db.VarChar(100)
  label       String @db.VarChar(100)
  color       String @default("#6366f1") @db.VarChar(20) // Hex color
  order_index Int    @default(0)
  config      Json?

  pipeline          UiPipeline       @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  records           Record[]
  crm_opportunities CrmOpportunity[]

  tenant_id Int
  tenant    Tenant @relation("TenantUiPipelineStage", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("ui_pipeline_stages")
}

/// A data record belonging to a UI Object.
/// Acts as an anchor for activities, tasks and audit_logs.
/// Field values are stored in the appropriate crm_* relational table (for CRM
/// objects) rather than as a JSON blob.  Custom objects that have no relational
/// table can still use this row as their identity / stage anchor.
model Record {
  id                Int      @id @default(autoincrement())
  object_id         Int
  pipeline_stage_id Int?
  assigned_to       String?  @db.VarChar(20) // FK → employees.employee_id
  created_by        String?  @db.VarChar(100)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Soft-delete / Trash: when set, the record is hidden from all users but
  // retained in the DB and recoverable by an admin. NULL = live record.
  deleted_at DateTime?
  deleted_by String?   @db.VarChar(100)

  object            UiObject           @relation(fields: [object_id], references: [id], onDelete: Cascade)
  pipeline_stage    UiPipelineStage?   @relation(fields: [pipeline_stage_id], references: [id], onDelete: SetNull)
  assigned_employee Employee?          @relation("RecordAssignee", fields: [assigned_to], references: [employee_id], onDelete: SetNull)
  activities        Activity[]
  tasks             Task[]
  reminders         Reminder[]
  audit_logs        AuditLog[]
  status_events     StatusEvent[]
  field_values      RecordFieldValue[]

  tenant_id Int
  tenant    Tenant @relation("TenantRecord", fields: [tenant_id], references: [id])

  // CRM relational bridge — populated by CrmService dual-write
  crm_lead        CrmLead?
  crm_lead_intake CrmLeadIntake?
  crm_contact     CrmContact?
  crm_account     CrmAccount?
  crm_opportunity CrmOpportunity?
  crm_case        CrmCase?

  // New CRM features
  product               Product?
  quote                 Quote?
  email_template        EmailTemplate?
  document              Document?
  // Insurance domain bridges
  insurance_policy      InsurancePolicy?
  insurance_application InsuranceApplication?
  insurance_claim       InsuranceClaim?

  @@index([assigned_to])
  @@index([tenant_id])
  @@index([deleted_at])
  @@map("records")
}

// ============================================================
// CRM OPERATIONAL TABLES
// ============================================================

/// Activity log for a CRM record (calls, emails, notes, meetings, etc.)
model Activity {
  id           Int       @id @default(autoincrement())
  record_id    Int
  employee_id  String    @db.VarChar(20)
  type         String    @db.VarChar(50) // note | call | email | meeting | task | other
  subject      String    @db.VarChar(200)
  description  String?   @db.Text
  outcome      String?   @db.VarChar(500)
  duration_min Int?
  scheduled_at DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  record   Record   @relation(fields: [record_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [employee_id])

  tenant_id Int
  tenant    Tenant @relation("TenantActivity", fields: [tenant_id], references: [id])

  @@index([record_id])
  @@index([employee_id])
  @@index([tenant_id])
  @@map("activities")
}

/// Task / reminder attached to a CRM record
model Task {
  id           Int       @id @default(autoincrement())
  record_id    Int?
  assigned_to  String    @db.VarChar(20)
  created_by   String    @db.VarChar(20)
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  status       String    @default("open") @db.VarChar(30) // open | in_progress | completed | cancelled
  priority     String    @default("normal") @db.VarChar(20) // low | normal | high | urgent
  due_date     DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  record   Record?  @relation(fields: [record_id], references: [id], onDelete: SetNull)
  assignee Employee @relation("TaskAssignee", fields: [assigned_to], references: [employee_id])
  creator  Employee @relation("TaskCreator", fields: [created_by], references: [employee_id])

  tenant_id Int
  tenant    Tenant @relation("TenantTask", fields: [tenant_id], references: [id])

  @@index([record_id])
  @@index([assigned_to])
  @@index([tenant_id])
  @@map("tasks")
}

/// In-app notification for an employee
model Notification {
  id          Int      @id @default(autoincrement())
  employee_id String   @db.VarChar(20)
  type        String   @db.VarChar(50) // task_due | record_assigned | mention | workflow | system
  title       String   @db.VarChar(200)
  body        String?  @db.Text
  link        String?  @db.VarChar(500)
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  employee Employee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantNotification", fields: [tenant_id], references: [id])

  @@index([employee_id, is_read])
  @@index([tenant_id])
  @@map("notifications")
}

/// A time-based reminder / follow-up attached to a CRM record (or standalone).
/// When `remind_at` passes, the reminder scheduler creates an in-app
/// Notification (type `reminder`) for the target employee — so reminders surface
/// in the notification bell automatically. `snooze` reschedules `remind_at` and
/// resets status to pending. Mirrors the reminder/follow-up primitive in
/// Salesforce, HubSpot, Dynamics, Zoho, and Pipedrive.
model Reminder {
  id           Int       @id @default(autoincrement())
  record_id    Int?
  employee_id  String    @db.VarChar(20) // who is reminded
  created_by   String    @db.VarChar(20)
  title        String    @db.VarChar(200)
  note         String?   @db.Text
  remind_at    DateTime
  status       String    @default("pending") @db.VarChar(20) // pending | notified | done | dismissed | cancelled
  priority     String    @default("normal") @db.VarChar(20) // low | normal | high | urgent
  notified_at  DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  record   Record?  @relation(fields: [record_id], references: [id], onDelete: SetNull)
  employee Employee @relation("ReminderAssignee", fields: [employee_id], references: [employee_id])
  creator  Employee @relation("ReminderCreator", fields: [created_by], references: [employee_id])

  tenant_id Int
  tenant    Tenant @relation("TenantReminder", fields: [tenant_id], references: [id])

  @@index([remind_at, status])
  @@index([employee_id, status])
  @@index([record_id])
  @@index([tenant_id])
  @@map("reminders")
}

/// Audit trail: every create / update / delete on a Record
model AuditLog {
  id          Int      @id @default(autoincrement())
  // record_id is nullable so audit entries survive a hard-delete/purge of the
  // record (FK is SET NULL, not CASCADE) — the trail must outlive the data.
  record_id   Int?
  // For actions on non-record entities (e.g. pipeline config). null for record actions.
  entity_type String?  @db.VarChar(50) // pipeline | ...
  entity_id   Int?
  employee_id String   @db.VarChar(20)
  action      String   @db.VarChar(40) // create | update | delete | stage_change | restore | purge | pipeline.create | pipeline.update | pipeline.delete
  changes     Json? // { field: { old, new } } or action-specific payload
  created_at  DateTime @default(now())

  record   Record?  @relation(fields: [record_id], references: [id], onDelete: SetNull)
  employee Employee @relation(fields: [employee_id], references: [employee_id])

  tenant_id Int
  tenant    Tenant @relation("TenantAuditLog", fields: [tenant_id], references: [id])

  @@index([record_id])
  @@index([entity_type, entity_id])
  @@index([tenant_id])
  @@map("audit_logs")
}

/// Timeline status event for a Record — powers the `status_tracker` fieldtype
/// (Amazon / UPS / Bluedart-style package tracking). Each row is one dated
/// milestone or scan event with an optional location and human description.
/// Events are appended on pipeline stage changes (auto) and can be added
/// manually via the API. Read-only at the field level; the field renders the
/// full chronological timeline for a record.
model StatusEvent {
  id          Int      @id @default(autoincrement())
  record_id   Int
  status      String   @db.VarChar(60) // milestone key — ideally matches a pipeline stage `name`
  title       String?  @db.VarChar(200) // human label, e.g. "Out for delivery"
  description String?  @db.Text // free-text detail for this event
  location    String?  @db.VarChar(200) // optional location, e.g. "Mumbai Hub, IN"
  event_type  String   @default("milestone") @db.VarChar(30) // milestone | scan | note | exception
  occurred_at DateTime @default(now()) // when it happened — drives timeline ordering
  changed_by  String?  @db.VarChar(20) // employees.employee_id (resolved to a name on read)
  created_at  DateTime @default(now())

  record Record @relation(fields: [record_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantStatusEvent", fields: [tenant_id], references: [id])

  @@index([record_id, occurred_at])
  @@index([tenant_id])
  @@map("status_events")
}

// ============================================================
// PERMISSION TABLES
// ============================================================

/// Role-based view/edit permission for a metadata entity.
/// entity_type: module | object | field | form | pipeline | wizard
/// Behaviour when no row exists for a role:
///   super_admin / admin → can_view=true, can_edit=true  (implicit full access)
///   other roles         → can_view=true, can_edit=false (default: view-only)
/// Set can_view=false to fully hide an entity from a role at runtime.
model UiPermission {
  id          Int      @id @default(autoincrement())
  entity_type String   @db.VarChar(50)
  entity_id   Int
  role_name   String   @db.VarChar(50)
  can_view    Boolean  @default(true)
  can_edit    Boolean  @default(false)
  updated_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantUiPermission", fields: [tenant_id], references: [id])

  @@unique([entity_type, entity_id, role_name, tenant_id])
  @@index([entity_type, entity_id])
  @@index([tenant_id])
  @@map("ui_permissions")
}

/// Role-based operational scope permissions for tasks and activities.
/// Scopes: none | own | team | hierarchy | all
/// "team"      = direct reports (depth=1 in employee_hierarchy)
/// "hierarchy" = all descendants at any depth
/// Behaviour when no row exists for a role: hardcoded defaults apply (see PermissionService).
model OperationalPermission {
  id           Int      @id @default(autoincrement())
  entity_type  String   @db.VarChar(30) // task | activity
  role_name    String   @db.VarChar(50)
  view_scope   String   @default("own") @db.VarChar(20)
  create_scope String   @default("own") @db.VarChar(20)
  edit_scope   String   @default("own") @db.VarChar(20)
  delete_scope String   @default("own") @db.VarChar(20)
  assign_scope String   @default("none") @db.VarChar(20)
  updated_by   String?  @db.VarChar(20)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantOperationalPermission", fields: [tenant_id], references: [id])

  @@unique([entity_type, role_name, tenant_id])
  @@index([tenant_id])
  @@map("operational_permissions")
}

// ============================================================
// ASSIGNMENT ENGINE
// ============================================================

/// Configurable assignment rule for a UiObject.
/// When a new record is created, the engine evaluates active rules in order_index order.
/// rule_type: fixed | round_robin | rule_based | load_balanced
/// conditions: array of { field, operator, value } — all must match for rule_based
/// assignee_id: fixed target employee (rule_type=fixed)
/// pool_ids: JSON array of employee_ids for round_robin / load_balanced pools
/// fallback_id: used when no rule matches or pool is empty
model AssignmentRule {
  id          Int      @id @default(autoincrement())
  object_id   Int
  name        String   @db.VarChar(100)
  rule_type   String   @db.VarChar(30) // fixed | round_robin | rule_based | load_balanced
  conditions  Json? // [{ field, operator, value }] — for rule_based only
  assignee_id String?  @db.VarChar(20) // FK → employees.employee_id (fixed rule)
  pool_ids    Json? // ["E001","E002"] — for round_robin / load_balanced
  fallback_id String?  @db.VarChar(20) // FK → employees.employee_id
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  object            UiObject         @relation(fields: [object_id], references: [id], onDelete: Cascade)
  round_robin_state RoundRobinState?

  tenant_id Int
  tenant    Tenant @relation("TenantAssignmentRule", fields: [tenant_id], references: [id])

  @@index([object_id, is_active, order_index])
  @@index([tenant_id])
  @@map("assignment_rules")
}

/// Tracks who was last assigned in a round-robin pool, per assignment rule.
/// Keyed per-rule so multiple round-robin rules on the same object do not interfere.
model RoundRobinState {
  rule_id    Int      @id
  pool_ids   Json // serialised ordered pool list
  last_index Int      @default(0) // index of last employee assigned
  updated_at DateTime @updatedAt

  rule AssignmentRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantRoundRobinState", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("round_robin_states")
}

/// Configurable routing for INBOUND social conversations (mentions / DMs /
/// comments). Mirrors AssignmentRule (fixed | round_robin | rule_based |
/// load_balanced) but is scoped by social `platform` instead of a UiObject,
/// and carries its round-robin cursor inline (`last_index`). When no active
/// rule matches a mention, the service falls back to its default
/// managed-by-team, load-balanced routing.
model SocialAssignmentRule {
  id          Int      @id @default(autoincrement())
  platform    String?  @db.VarChar(50) // null = all platforms; else facebook|instagram|linkedin|twitter|whatsapp|youtube|tiktok
  name        String   @db.VarChar(100)
  rule_type   String   @db.VarChar(30) // fixed | round_robin | rule_based | load_balanced
  conditions  Json? // [{ field, operator, value }] over mention fields — rule_based only
  assignee_id String?  @db.VarChar(20) // FK → employees.employee_id (fixed rule)
  pool_ids    Json? // ["E001","E002"] — round_robin / load_balanced
  fallback_id String?  @db.VarChar(20) // FK → employees.employee_id
  order_index Int      @default(0)
  is_active   Boolean  @default(true)
  last_index  Int      @default(0) // round-robin cursor (inline; no separate state table)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantSocialAssignmentRule", fields: [tenant_id], references: [id])

  @@index([tenant_id, platform, is_active, order_index], map: "social_assign_rules_lookup_idx")
  @@map("social_assignment_rules")
}

/// Immutable trace of every assignment decision for auditability.
model AssignmentLog {
  id          Int      @id @default(autoincrement())
  record_id   Int
  object_id   Int
  rule_id     Int? // null = manual assignment
  assigned_to String   @db.VarChar(20)
  method      String   @db.VarChar(30) // fixed | round_robin | rule_based | fallback | manual
  created_at  DateTime @default(now())

  tenant_id Int
  tenant    Tenant @relation("TenantAssignmentLog", fields: [tenant_id], references: [id])

  @@index([record_id])
  @@index([object_id])
  @@index([tenant_id])
  @@map("assignment_logs")
}

// ============================================================
// FORECASTING / QUOTAS
// ============================================================

/// Sales quota for one employee × object × time period.
/// period_type: monthly | quarterly | annual
/// period_key:  "2026-03" | "2026-Q1" | "2026"
model Quota {
  id           Int      @id @default(autoincrement())
  employee_id  String   @db.VarChar(20)
  object_id    Int
  period_type  String   @db.VarChar(20)
  period_key   String   @db.VarChar(20)
  target_value Decimal  @db.Decimal(18, 2)
  currency     String   @default("USD") @db.VarChar(10)
  created_by   String?  @db.VarChar(20)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade)
  object   UiObject @relation(fields: [object_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantQuota", fields: [tenant_id], references: [id])

  @@unique([employee_id, object_id, period_type, period_key])
  @@index([employee_id])
  @@index([object_id])
  @@index([tenant_id])
  @@map("quotas")
}

// ============================================================
// IMPORT / DEDUPE
// ============================================================

/// Tracks a CSV import job through its lifecycle.
/// status: pending | previewing | importing | done | failed
/// strategy: skip | create | merge  — duplicate resolution behaviour
model ImportJob {
  id            Int      @id @default(autoincrement())
  object_id     Int
  filename      String   @db.VarChar(255)
  status        String   @default("pending") @db.VarChar(20)
  field_mapping Json? // { "CSV Header": "field_name" }
  dedupe_keys   Json? // ["email"] — fields used for duplicate detection
  strategy      String   @default("skip") @db.VarChar(20)
  stats         Json? // { total, created, merged, skipped, errors }
  error_rows    Json? // [{ row, errors }]
  created_by    String   @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  object UiObject @relation(fields: [object_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantImportJob", fields: [tenant_id], references: [id])

  @@index([object_id])
  @@index([status])
  @@index([tenant_id])
  @@map("import_jobs")
}

// ============================================================
// INTEGRATION FRAMEWORK
// ============================================================

/// Registered integration connector instance.
/// type: outbound_webhook | email_sync | enrichment | custom
/// config: encrypted (at rest) connector-specific settings
model Integration {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  label       String    @db.VarChar(100)
  type        String    @db.VarChar(50)
  config      Json? // connector-specific settings (treat as sensitive)
  is_active   Boolean   @default(true)
  last_run_at DateTime?
  created_by  String?   @db.VarChar(20)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantIntegration", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("integrations")
}

/// Log entry for an integration execution.
model IntegrationLog {
  id             Int      @id @default(autoincrement())
  integration_id Int
  status         String   @db.VarChar(20) // success | failure | skipped
  request_body   Json?
  response_body  Json?
  error          String?  @db.Text
  duration_ms    Int?
  created_at     DateTime @default(now())

  tenant_id Int
  tenant    Tenant @relation("TenantIntegrationLog", fields: [tenant_id], references: [id])

  @@index([integration_id])
  @@index([tenant_id])
  @@map("integration_logs")
}

// ============================================================
// CRM RELATIONAL LAYER
// First-class relational tables for all core CRM entities.
// Each row has a nullable record_id → records.id bridge so activities,
// tasks, and audit_logs can be referenced by record_id.
// The records table no longer stores field data in JSON;
// all CRM field values live exclusively in the crm_* tables.
// Custom objects (campaign, settings, …) that have no crm_* table
// use the Record row as a minimal identity/stage anchor only.
// ============================================================

/// Relational account — company / organisation record.
model CrmAccount {
  id              Int      @id @default(autoincrement())
  record_id       Int?     @unique // bridge → records.id
  name            String   @db.VarChar(255)
  website         String?  @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  email           String?  @db.VarChar(100)
  industry        String?  @db.VarChar(100)
  account_type    String?  @db.VarChar(50) // prospect | customer | partner | competitor
  annual_revenue  Decimal? @db.Decimal(18, 2)
  employee_count  Int?
  billing_street  String?  @db.VarChar(255)
  billing_city    String?  @db.VarChar(100)
  billing_state   String?  @db.VarChar(100)
  billing_country String?  @db.VarChar(100)
  billing_zip     String?  @db.VarChar(20)
  description     String?  @db.Text
  owner_id        String?  @db.VarChar(20)
  external_id     String?  @db.VarChar(255) // integration dedupe key
  created_by      String?  @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  record                 Record?                @relation(fields: [record_id], references: [id], onDelete: SetNull)
  owner                  Employee?              @relation("AccountOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)
  contacts               CrmContact[]
  opportunities          CrmOpportunity[]
  cases                  CrmCase[]
  lead_conversions       CrmLeadConversion[]
  quotes                 Quote[]
  // Insurance relations
  insurance_policies     InsurancePolicy[]      @relation("PolicyAccount")
  insurance_applications InsuranceApplication[] @relation("ApplicationAccount")

  tenant_id Int
  tenant    Tenant @relation("TenantCrmAccount", fields: [tenant_id], references: [id])

  @@index([name])
  @@index([owner_id])
  @@index([external_id])
  @@index([tenant_id])
  @@map("crm_accounts")
}

/// Relational contact — person record, optionally linked to an account.
model CrmContact {
  id              Int       @id @default(autoincrement())
  record_id       Int?      @unique
  account_id      Int?
  first_name      String    @db.VarChar(100)
  last_name       String    @db.VarChar(100)
  email           String?   @db.VarChar(100)
  phone           String?   @db.VarChar(50)
  mobile          String?   @db.VarChar(50)
  title           String?   @db.VarChar(100)
  department      String?   @db.VarChar(100)
  lead_source     String?   @db.VarChar(100)
  mailing_street  String?   @db.VarChar(255)
  mailing_city    String?   @db.VarChar(100)
  mailing_state   String?   @db.VarChar(100)
  mailing_country String?   @db.VarChar(100)
  mailing_zip     String?   @db.VarChar(20)
  birthdate       DateTime? @db.Date
  description     String?   @db.Text
  do_not_contact  Boolean   @default(false)
  owner_id        String?   @db.VarChar(20)
  external_id     String?   @db.VarChar(255)
  created_by      String?   @db.VarChar(20)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  record                 Record?                      @relation(fields: [record_id], references: [id], onDelete: SetNull)
  account                CrmAccount?                  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  owner                  Employee?                    @relation("ContactOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)
  opportunities          CrmOpportunity[]             @relation("OpportunityContact")
  cases                  CrmCase[]
  lead_conversions       CrmLeadConversion[]
  quotes                 Quote[]
  // Insurance relations
  insurance_policies     InsurancePolicy[]            @relation("PolicyContact")
  insurance_applications InsuranceApplication[]       @relation("ApplicationContact")
  insurance_claims       InsuranceClaim[]             @relation("ClaimContact")
  policy_beneficiaries   InsurancePolicyBeneficiary[] @relation("BeneficiaryContact")
  quote_scenarios        QuoteScenario[]              @relation("ScenarioContact")
  compliance_artifacts   ComplianceArtifact[]         @relation("ComplianceContact")

  tenant_id Int
  tenant    Tenant @relation("TenantCrmContact", fields: [tenant_id], references: [id])

  @@index([email])
  @@index([account_id])
  @@index([owner_id])
  @@index([external_id])
  @@index([tenant_id])
  @@map("crm_contacts")
}

/// Relational lead — inbound prospect before qualification / conversion.
model CrmLead {
  id             Int       @id @default(autoincrement())
  record_id      Int?      @unique
  first_name     String    @db.VarChar(100)
  last_name      String    @db.VarChar(100)
  company        String?   @db.VarChar(255)
  email          String?   @db.VarChar(100)
  phone          String?   @db.VarChar(50)
  mobile         String?   @db.VarChar(50)
  job_title      String?   @db.VarChar(100)
  lead_source    String?   @db.VarChar(100)
  lead_status    String    @default("new") @db.VarChar(50) // new | contacted | qualified | unqualified | converted
  rating         String?   @db.VarChar(20) // hot | warm | cold
  industry       String?   @db.VarChar(100)
  annual_revenue Decimal?  @db.Decimal(18, 2)
  website        String?   @db.VarChar(255)
  description    String?   @db.Text
  is_converted   Boolean   @default(false)
  converted_at   DateTime?
  owner_id       String?   @db.VarChar(20)
  external_id    String?   @db.VarChar(255)
  created_by     String?   @db.VarChar(20)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  record      Record?            @relation(fields: [record_id], references: [id], onDelete: SetNull)
  owner       Employee?          @relation("LeadOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)
  conversion  CrmLeadConversion?
  lead_scores LeadScore[]        @relation("LeadScores")

  tenant_id Int
  tenant    Tenant @relation("TenantCrmLead", fields: [tenant_id], references: [id])

  @@index([email])
  @@index([company])
  @@index([lead_status])
  @@index([owner_id])
  @@index([external_id])
  @@index([tenant_id])
  @@map("crm_leads")
}

/// Raw, unqualified inbound lead (UI object "Lead", internal name `lead_intake`).
/// Sits in front of Prospect: qualifying/converting a lead creates a CrmLead
/// (Prospect). Kept separate from crm_leads so raw inbound never pollutes the
/// working prospect pipeline. See CrmService.convertLeadToProspect.
model CrmLeadIntake {
  id                    Int       @id @default(autoincrement())
  record_id             Int?      @unique
  first_name            String    @db.VarChar(100)
  last_name             String    @db.VarChar(100)
  company               String?   @db.VarChar(255)
  email                 String?   @db.VarChar(100)
  phone                 String?   @db.VarChar(50)
  mobile                String?   @db.VarChar(50)
  job_title             String?   @db.VarChar(100)
  lead_source           String?   @db.VarChar(100)
  lead_status           String    @default("new") @db.VarChar(50) // new | contacted | qualified | converted
  rating                String?   @db.VarChar(20) // hot | warm | cold
  industry              String?   @db.VarChar(100)
  annual_revenue        Decimal?  @db.Decimal(18, 2)
  website               String?   @db.VarChar(255)
  description           String?   @db.Text
  is_converted          Boolean   @default(false)
  converted_at          DateTime?
  converted_prospect_id Int? // → crm_leads.id created on conversion
  owner_id              String?   @db.VarChar(20)
  external_id           String?   @db.VarChar(255)
  created_by            String?   @db.VarChar(20)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  record      Record?     @relation(fields: [record_id], references: [id], onDelete: SetNull)
  owner       Employee?   @relation("LeadIntakeOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)
  lead_scores LeadScore[] @relation("LeadIntakeScores")

  tenant_id Int
  tenant    Tenant @relation("TenantCrmLeadIntake", fields: [tenant_id], references: [id])

  @@index([email])
  @@index([lead_status])
  @@index([owner_id])
  @@index([tenant_id])
  @@map("crm_lead_intake")
}

/// Relational opportunity — qualified deal in the sales pipeline.
model CrmOpportunity {
  id                Int       @id @default(autoincrement())
  record_id         Int?      @unique
  account_id        Int?
  contact_id        Int?
  name              String    @db.VarChar(255)
  amount            Decimal?  @db.Decimal(18, 2)
  currency          String    @default("USD") @db.VarChar(10)
  stage             String    @default("prospecting") @db.VarChar(50)
  probability       Int       @default(0) // 0–100
  close_date        DateTime? @db.Date
  lead_source       String?   @db.VarChar(100)
  type              String?   @db.VarChar(100) // new_business | existing_business | renewal
  next_step         String?   @db.VarChar(255)
  description       String?   @db.Text
  is_closed         Boolean   @default(false)
  is_won            Boolean   @default(false)
  forecast_category String?   @db.VarChar(50) // pipeline | best_case | commit | closed
  pipeline_stage_id Int? // back-compat with existing kanban board
  owner_id          String?   @db.VarChar(20)
  external_id       String?   @db.VarChar(255)
  created_by        String?   @db.VarChar(20)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  record          Record?            @relation(fields: [record_id], references: [id], onDelete: SetNull)
  account         CrmAccount?        @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contact         CrmContact?        @relation("OpportunityContact", fields: [contact_id], references: [id], onDelete: SetNull)
  pipeline_stage  UiPipelineStage?   @relation(fields: [pipeline_stage_id], references: [id], onDelete: SetNull)
  owner           Employee?          @relation("OpportunityOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)
  lead_conversion CrmLeadConversion?
  quotes          Quote[]

  tenant_id Int
  tenant    Tenant @relation("TenantCrmOpportunity", fields: [tenant_id], references: [id])

  @@index([account_id])
  @@index([stage])
  @@index([owner_id])
  @@index([close_date])
  @@index([amount])
  @@index([external_id])
  @@index([tenant_id])
  @@map("crm_opportunities")
}

/// Relational case — customer support ticket.
model CrmCase {
  id            Int      @id @default(autoincrement())
  record_id     Int?     @unique
  account_id    Int?
  contact_id    Int?
  subject       String   @db.VarChar(255)
  description   String?  @db.Text
  status        String   @default("new") @db.VarChar(50) // new | open | in_progress | escalated | resolved | closed
  priority      String   @default("medium") @db.VarChar(20) // low | medium | high | critical
  type          String?  @db.VarChar(100)
  origin        String?  @db.VarChar(50) // web | email | phone | chat
  contact_email String?  @db.VarChar(100)
  contact_name  String?  @db.VarChar(200)
  resolution    String?  @db.Text
  owner_id      String?  @db.VarChar(20)
  external_id   String?  @db.VarChar(255)
  created_by    String?  @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  record  Record?     @relation(fields: [record_id], references: [id], onDelete: SetNull)
  account CrmAccount? @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contact CrmContact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  owner   Employee?   @relation("CaseOwner", fields: [owner_id], references: [employee_id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantCrmCase", fields: [tenant_id], references: [id])

  @@index([account_id])
  @@index([status])
  @@index([owner_id])
  @@index([external_id])
  @@index([tenant_id])
  @@map("crm_cases")
}

/// Immutable audit record of a lead conversion event.
/// One lead → at most one conversion.  The conversion may create a new
/// Account, Contact, and/or Opportunity; all three links are optional.
model CrmLeadConversion {
  id             Int      @id @default(autoincrement())
  lead_id        Int      @unique // one conversion per lead
  account_id     Int?
  contact_id     Int?
  opportunity_id Int?     @unique // one opportunity per conversion
  converted_by   String?  @db.VarChar(20)
  converted_at   DateTime @default(now())
  notes          String?  @db.Text
  created_at     DateTime @default(now())

  lead        CrmLead?        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  account     CrmAccount?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contact     CrmContact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantCrmLeadConversion", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("crm_lead_conversions")
}

/// Generic many-to-many association between any two CRM entities.
/// Avoids a combinatorial explosion of join tables while still being queryable.
/// assoc_type: primary_contact | decision_maker | influencer | billing_contact | ...
model CrmAssociation {
  id         Int      @id @default(autoincrement())
  from_type  String   @db.VarChar(50) // lead | contact | account | opportunity | case
  from_id    Int
  to_type    String   @db.VarChar(50)
  to_id      Int
  assoc_type String   @db.VarChar(100)
  created_by String?  @db.VarChar(20)
  created_at DateTime @default(now())

  tenant_id Int
  tenant    Tenant @relation("TenantCrmAssociation", fields: [tenant_id], references: [id])

  @@unique([from_type, from_id, to_type, to_id, assoc_type])
  @@index([from_type, from_id])
  @@index([to_type, to_id])
  @@index([tenant_id])
  @@map("crm_associations")
}

// ============================================================
// ESSENTIAL CRM FEATURES (MUST-HAVES)
// ============================================================

/// Product/Service catalog for quotes and opportunities
model Product {
  id              Int      @id @default(autoincrement())
  record_id       Int?     @unique // bridge → records.id
  name            String   @db.VarChar(255)
  sku             String?  @unique @db.VarChar(100)
  category        String?  @db.VarChar(100)
  description     String?  @db.Text
  unit_price      Decimal  @db.Decimal(18, 2)
  cost_price      Decimal? @db.Decimal(18, 2)
  currency        String   @default("USD") @db.VarChar(10)
  tax_rate        Decimal? @db.Decimal(5, 4) // 0.0825 for 8.25%
  is_active       Boolean  @default(true)
  is_service      Boolean  @default(false)
  min_quantity    Int      @default(1)
  max_quantity    Int?
  vendor_name     String?  @db.VarChar(255)
  vendor_sku      String?  @db.VarChar(100)
  dimensions      String?  @db.VarChar(100) // "10x15x5 cm"
  weight          Decimal? @db.Decimal(8, 2) // in kg
  warranty_months Int?
  image_url       String?  @db.VarChar(500) // product image URL
  created_by      String?  @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  record      Record?         @relation(fields: [record_id], references: [id], onDelete: SetNull)
  quote_items QuoteLineItem[]

  tenant_id Int
  tenant    Tenant @relation("TenantProduct", fields: [tenant_id], references: [id])

  @@index([name])
  @@index([category])
  @@index([is_active])
  @@index([sku])
  @@index([tenant_id])
  @@map("products")
}

/// Quote/Proposal generation for opportunities
model Quote {
  id               Int       @id @default(autoincrement())
  record_id        Int?      @unique // bridge → records.id
  opportunity_id   Int?
  account_id       Int?
  contact_id       Int?
  quote_number     String    @unique @db.VarChar(50)
  name             String    @db.VarChar(255)
  status           String    @default("draft") @db.VarChar(50) // draft | sent | accepted | rejected | expired
  valid_until      DateTime? @db.Date
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  discount_amount  Decimal   @default(0) @db.Decimal(18, 2)
  discount_percent Decimal   @default(0) @db.Decimal(5, 2) // 15.50 for 15.5%
  tax_amount       Decimal   @default(0) @db.Decimal(18, 2)
  total_amount     Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("USD") @db.VarChar(10)
  terms            String?   @db.Text
  notes            String?   @db.Text
  billing_street   String?   @db.VarChar(255)
  billing_city     String?   @db.VarChar(100)
  billing_state    String?   @db.VarChar(100)
  billing_country  String?   @db.VarChar(100)
  billing_zip      String?   @db.VarChar(20)
  shipping_street  String?   @db.VarChar(255)
  shipping_city    String?   @db.VarChar(100)
  shipping_state   String?   @db.VarChar(100)
  shipping_country String?   @db.VarChar(100)
  shipping_zip     String?   @db.VarChar(20)
  accepted_at      DateTime?
  sent_at          DateTime?
  owner_id         String?   @db.VarChar(20)
  created_by       String?   @db.VarChar(20)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  record      Record?         @relation(fields: [record_id], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunity_id], references: [id], onDelete: SetNull)
  account     CrmAccount?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contact     CrmContact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  owner       Employee?       @relation(fields: [owner_id], references: [employee_id], onDelete: SetNull)
  line_items  QuoteLineItem[]

  tenant_id Int
  tenant    Tenant @relation("TenantQuote", fields: [tenant_id], references: [id])

  @@index([quote_number])
  @@index([status])
  @@index([opportunity_id])
  @@index([owner_id])
  @@index([tenant_id])
  @@map("quotes")
}

/// Individual line item in a quote
model QuoteLineItem {
  id          Int     @id @default(autoincrement())
  quote_id    Int
  product_id  Int?
  name        String  @db.VarChar(255) // product name (copied at quote time)
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2) // percentage
  line_total  Decimal @db.Decimal(18, 2)
  order_index Int     @default(0)

  quote   Quote    @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantQuoteLineItem", fields: [tenant_id], references: [id])

  @@index([quote_id])
  @@index([tenant_id])
  @@map("quote_line_items")
}

/// Email templates for marketing and communications
model EmailTemplate {
  id          Int      @id @default(autoincrement())
  record_id   Int?     @unique // bridge → records.id
  object_id   Int? // scoped to a specific UiObject (e.g. Lead, Contact)
  name        String   @db.VarChar(255)
  category    String?  @db.VarChar(100) // sales | marketing | support | onboarding
  subject     String   @db.VarChar(255)
  body_html   String?  @db.MediumText
  body_text   String?  @db.Text
  variables   Json? // ["first_name", "company", "amount"]
  is_active   Boolean  @default(true)
  usage_count Int      @default(0)
  language    String   @default("en") @db.VarChar(10)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  record     Record?    @relation(fields: [record_id], references: [id], onDelete: SetNull)
  object     UiObject?  @relation(fields: [object_id], references: [id], onDelete: SetNull)
  email_logs EmailLog[]

  tenant_id Int
  tenant    Tenant @relation("TenantEmailTemplate", fields: [tenant_id], references: [id])

  @@index([object_id])
  @@index([category])
  @@index([is_active])
  @@index([tenant_id])
  @@map("email_templates")
}

/// Log of email communications
model EmailLog {
  id                Int       @id @default(autoincrement())
  template_id       Int?
  related_record_id Int? // what record this email relates to
  related_type      String?   @db.VarChar(50) // lead | contact | account | opportunity | case
  to_email          String    @db.VarChar(255)
  from_email        String?   @db.VarChar(255)
  cc_emails         Json? // array of CC email addresses
  bcc_emails        Json? // array of BCC email addresses  
  subject           String    @db.VarChar(255)
  body_html         String?   @db.MediumText
  body_text         String?   @db.Text
  status            String    @default("sent") @db.VarChar(50) // sent | bounced | delivered | opened | clicked
  opened_at         DateTime?
  clicked_at        DateTime?
  bounced_at        DateTime?
  bounce_reason     String?   @db.Text
  sent_by           String?   @db.VarChar(20)
  sent_at           DateTime  @default(now())
  created_at        DateTime  @default(now())

  template EmailTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  tenant_id Int
  tenant    Tenant @relation("TenantEmailLog", fields: [tenant_id], references: [id])

  @@index([to_email])
  @@index([status])
  @@index([related_record_id, related_type])
  @@index([sent_at])
  @@index([tenant_id])
  @@map("email_logs")
}

/// Document/file attachments for records
/// Unified document model — the single content store for ALL document types
/// (generic CRM attachments, insurance application documents, auto-archived
/// reports, compliance artifacts). Bytes live in blob storage under a
/// tenant-first relative key (`stored_key`); this row holds all metadata.
model Document {
  id           Int     @id @default(autoincrement())
  record_id    Int?    @unique // bridge → runtime records.id
  document_ref String? @db.VarChar(100) // human reference e.g. DOC-APP2026001-001

  // Polymorphic owner (what this document is attached to)
  entity_type    String? @db.VarChar(50) // lead | contact | account | opportunity | case | quote | application | policy
  entity_id      Int? // owning record id
  application_id Int? // typed link for insurance applications

  original_filename String  @db.VarChar(255) // user's original filename
  stored_key        String  @db.VarChar(500) // RELATIVE storage key (never an absolute path)
  file_size         Int? // bytes
  mime_type         String? @db.VarChar(100)
  file_hash         String? @db.VarChar(64) // SHA-256 — integrity verification & dedup
  category          String? @db.VarChar(100) // contract | proof_of_income | reports | photo | other
  folder_id         Int? // optional organising folder (DocumentFolder)
  description       String? @db.Text
  notes             String? @db.Text

  // Extracted plain-text (pdf/docx/txt) for full-text search. Best-effort,
  // populated on upload; null when the type isn't extractable or extraction failed.
  content_text String? @db.MediumText

  version   Int     @default(1) // incremented when a new file supersedes an old one
  status    String  @default("uploaded") @db.VarChar(30) // required | pending | uploaded | under_review | approved | rejected | waived | deleted
  is_public Boolean @default(false)

  uploaded_by      String?   @db.VarChar(20)
  uploaded_at      DateTime? @default(now())
  reviewed_by      String?   @db.VarChar(20)
  reviewed_at      DateTime?
  rejection_reason String?   @db.Text

  deleted_at DateTime? // soft-delete marker for atomic GC
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  record               Record?                    @relation(fields: [record_id], references: [id], onDelete: SetNull)
  application          InsuranceApplication?      @relation("AppDocuments", fields: [application_id], references: [id], onDelete: Cascade)
  compliance_artifacts ComplianceArtifact[]       @relation("ComplianceDocument")
  checklist_items      SubmissionChecklist[]      @relation("ChecklistDocument")
  folder               DocumentFolder?            @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  share_links          DocumentShareLink[]
  signature_requests   DocumentSignatureRequest[] @relation("DocSignatureRequests")

  tenant_id Int
  tenant    Tenant @relation("TenantDocument", fields: [tenant_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([application_id])
  @@index([category])
  @@index([status])
  @@index([file_hash])
  @@index([original_filename])
  @@index([folder_id])
  @@index([deleted_at])
  @@index([tenant_id])
  @@fulltext([original_filename, description, content_text], map: "documents_fulltext")
  @@map("documents")
}

/// Hierarchical folder for organising documents in the standalone DMS.
/// Self-referential tree with a materialised `path` for cheap breadcrumbs.
model DocumentFolder {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  parent_id   Int?
  path        String   @default("/") @db.VarChar(1000) // e.g. "/Contracts/2026"
  order_index Int      @default(0)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentFolder", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([parent_id])
  @@map("document_folders")
}

/// A shareable, optionally-expiring public link to a document. Anchors
/// engagement tracking (opens/downloads) for the standalone DMS.
model DocumentShareLink {
  id             Int       @id @default(autoincrement())
  document_id    Int
  token          String    @unique @db.VarChar(64) // unguessable public token
  allow_download Boolean   @default(true)
  expires_at     DateTime?
  is_active      Boolean   @default(true)
  view_count     Int       @default(0)
  last_viewed_at DateTime?
  created_by     String?   @db.VarChar(20)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  document Document            @relation(fields: [document_id], references: [id], onDelete: Cascade)
  events   DocumentViewEvent[]

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentShareLink", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([document_id])
  @@map("document_share_links")
}

/// A single view or download event against a share link (engagement analytics).
model DocumentViewEvent {
  id            Int      @id @default(autoincrement())
  share_link_id Int
  document_id   Int
  event_type    String   @default("view") @db.VarChar(20) // view | download
  viewer_ip     String?  @db.VarChar(64)
  user_agent    String?  @db.Text
  referrer      String?  @db.VarChar(500)
  duration_secs Int?
  viewed_at     DateTime @default(now())

  share_link DocumentShareLink @relation(fields: [share_link_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentViewEvent", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([share_link_id])
  @@index([document_id])
  @@map("document_view_events")
}

/// Tenant-configured document category (Document Management builder).
/// Drives the category dropdown, per-category upload rules, review policy and
/// retention in the standalone DMS. When a tenant has none configured the DMS
/// falls back to sensible built-in defaults.
model UiDocumentCategory {
  id              Int      @id @default(autoincrement())
  code            String   @db.VarChar(100) // machine key, e.g. "proof_of_income"
  label           String   @db.VarChar(100) // display name
  description     String?  @db.Text
  allowed_mime    Json? // array of allowed MIME types; null → inherit global policy
  max_file_mb     Int? // per-category size cap (MB); null → inherit global policy
  retention_days  Int? // per-category retention; null → inherit global policy
  review_required Boolean  @default(false) // uploads land in "under_review" not "uploaded"
  is_required     Boolean  @default(false) // part of the default required-document set
  color           String   @default("#6366f1") @db.VarChar(20)
  order_index     Int      @default(0)
  is_active       Boolean  @default(true)
  config          Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantUiDocumentCategory", fields: [tenant_id], references: [id])

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([is_active, order_index])
  @@map("ui_document_categories")
}

/// Required-document checklist for a given owner entity type (Document
/// Management builder). `items` is an ordered JSON list of
/// { category_code, required, label } referencing UiDocumentCategory codes.
model UiDocumentChecklist {
  id          Int      @id @default(autoincrement())
  entity_type String   @db.VarChar(50) // lead | contact | application | policy | ...
  label       String   @db.VarChar(100)
  description String?  @db.Text
  items       Json? // [{ category_code, required, label }]
  is_active   Boolean  @default(true)
  order_index Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantUiDocumentChecklist", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([entity_type])
  @@map("ui_document_checklists")
}

/// A native e-signature request against a document. Collects one or more
/// signatories; when all have signed a signature certificate (a Document) is
/// generated. Public signing happens via each signatory's unguessable token.
model DocumentSignatureRequest {
  id                 Int       @id @default(autoincrement())
  document_id        Int
  title              String?   @db.VarChar(200)
  message            String?   @db.Text
  status             String    @default("sent") @db.VarChar(20) // sent | completed | declined | cancelled | expired
  ordered            Boolean   @default(false) // enforce signatory order_index sequence
  expires_at         DateTime?
  completed_at       DateTime?
  certificate_doc_id Int? // generated signature-certificate Document id
  created_by         String?   @db.VarChar(20)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  document    Document            @relation("DocSignatureRequests", fields: [document_id], references: [id], onDelete: Cascade)
  signatories DocumentSignatory[]

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentSignatureRequest", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([document_id])
  @@map("document_signature_requests")
}

/// One signer within a signature request.
model DocumentSignatory {
  id             Int       @id @default(autoincrement())
  request_id     Int
  name           String    @db.VarChar(150)
  email          String    @db.VarChar(200)
  order_index    Int       @default(0)
  status         String    @default("pending") @db.VarChar(20) // pending | viewed | signed | declined
  token          String    @unique @db.VarChar(64) // unguessable public signing token
  signature_type String?   @db.VarChar(20) // typed | drawn
  signature_data String?   @db.MediumText // typed full-name or base64 PNG data URL
  decline_reason String?   @db.Text
  viewer_ip      String?   @db.VarChar(64)
  viewed_at      DateTime?
  signed_at      DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  request DocumentSignatureRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentSignatory", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([request_id])
  @@map("document_signatories")
}

/// Reusable merge-template for generating documents from any entity's data.
/// `body` is HTML/text containing {{placeholder}} tokens (dot-paths supported,
/// e.g. {{contact.first_name}}) filled from a merge context at render time.
model DocumentTemplate {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  description     String?  @db.Text
  entity_type     String?  @db.VarChar(50) // optional target entity (contact|lead|application|…)
  body            String   @db.MediumText // template source with {{placeholders}}
  format          String   @default("html") @db.VarChar(20) // html | text
  output_category String?  @db.VarChar(100) // category to file rendered documents under
  is_active       Boolean  @default(true)
  created_by      String?  @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantDocumentTemplate", fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([is_active])
  @@map("document_templates")
}

/// Lead scoring rules for automated qualification
model LeadScoringRule {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  field_name  String   @db.VarChar(100) // field to evaluate
  operator    String   @db.VarChar(50) // equals | contains | greater_than | less_than | in_list
  field_value String?  @db.Text // value to compare against
  points      Int // points awarded when rule matches
  rule_type   String   @db.VarChar(50) // demographic | behavioral | firmographic
  is_active   Boolean  @default(true)
  order_index Int      @default(0)
  created_by  String?  @db.VarChar(20)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant_id Int
  tenant    Tenant @relation("TenantLeadScoringRule", fields: [tenant_id], references: [id])

  @@index([is_active, order_index])
  @@index([tenant_id])
  @@map("lead_scoring_rules")
}

/// Lead scoring history for auditability
model LeadScore {
  id              Int      @id @default(autoincrement())
  lead_id         Int? // Prospect (crm_leads) — legacy/manual scoring
  lead_intake_id  Int? // Lead (crm_lead_intake) — primary scoring target
  total_score     Int      @default(0)
  scoring_details Json? // [{ rule_id, rule_name, points, matched_value }]
  calculated_at   DateTime @default(now())

  lead        CrmLead?       @relation("LeadScores", fields: [lead_id], references: [id], onDelete: Cascade)
  lead_intake CrmLeadIntake? @relation("LeadIntakeScores", fields: [lead_intake_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantLeadScore", fields: [tenant_id], references: [id])

  @@index([lead_id])
  @@index([lead_intake_id])
  @@index([total_score])
  @@index([tenant_id])
  @@map("lead_scores")
}

/// Stores typed field values for custom objects (EAV pattern)
model RecordFieldValue {
  id         BigInt    @id @default(autoincrement())
  record_id  Int
  field_name String    @db.VarChar(100)
  str_value  String?   @db.Text
  num_value  Float?
  bool_value Boolean?
  date_value DateTime?
  json_value Json?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  record Record @relation(fields: [record_id], references: [id], onDelete: Cascade)

  tenant_id Int
  tenant    Tenant @relation("TenantRecordFieldValue", fields: [tenant_id], references: [id])

  @@unique([record_id, field_name])
  @@index([record_id])
  @@index([tenant_id])
  @@map("record_field_values")
}

