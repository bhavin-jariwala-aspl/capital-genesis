# Database
DATABASE_URL="mysql://admin:Defence$1380@smartsure-mysql.ckwh4wdl5opw.us-east-2.rds.amazonaws.com:3306/genesis"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
JWT_EXPIRY="8h"

# Redis (optional — app degrades gracefully when Redis unavailable)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# Cache TTL in seconds
CACHE_TTL_METADATA=3600
CACHE_TTL_SESSION=28800

# ── AI reporting ("Ask") — Ollama on this machine ────────────
AI_REPORTING_ENABLED=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=90000
LLM_THINKING=false
