# Copy to .env.docker and fill in. Never commit the real file.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# 64 hex characters (AES-256 key for encrypted fields), e.g. `openssl rand -hex 32`
FIELD_ENCRYPTION_KEY=
# Optional outbound email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
